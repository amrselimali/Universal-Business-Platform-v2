{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] [{TraceId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ubp-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{TraceId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=ubp;Username=ubp_app;Password=ubp_app_dev_password",
    "MigrationConnectionString": "Host=localhost;Port=5432;Database=ubp;Username=postgres",
    "QaConnectionString": "Host=localhost;Port=5432;Database=ubp_qa;Username=postgres",
    "AutoMigrate": true,
    "AutoMigrateQa": true
  },
  "Jwt": {
    "Issuer": "UniversalBusinessPlatform",
    "Audience": "UniversalBusinessPlatform",
    "Key": "CHANGE-THIS-DEVELOPMENT-KEY-32-CHARS-MINIMUM-0001",
    "AccessTokenMinutes": 15
  },
  "Bootstrap": {
    "SuperAdminUsername": "admin",
    "SuperAdminPassword": "Admin@123",
    "SuperAdminName": "مدير النظام"
  },
  "AllowedHosts": "*"
}
