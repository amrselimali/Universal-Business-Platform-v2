{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] [{TraceId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ubp-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{TraceId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Database": {
    "ConnectionString": "",
    "MigrationConnectionString": "",
    "QaConnectionString": "",
    "AutoMigrate": false,
    "AutoMigrateQa": false
  },
  "Jwt": {
    "Issuer": "UniversalBusinessPlatform",
    "Audience": "UniversalBusinessPlatform",
    "Key": "",
    "AccessTokenMinutes": 15
  },
  "Bootstrap": {
    "SuperAdminUsername": "admin",
    "SuperAdminPassword": "",
    "SuperAdminName": "مدير النظام"
  },
  "DataProtection": {
    "KeyRingPath": ""
  },
  "AllowedHosts": "*"
}
