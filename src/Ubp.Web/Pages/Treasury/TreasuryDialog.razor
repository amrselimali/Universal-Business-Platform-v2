@inherits ComponentBase

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEdit ? T.T("treasury.edit_treasury") : T.T("treasury.add_treasury"))</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <div class="ubp-form-grid">
                <MudSelect T="Guid" @bind-Value="_input.BranchId" Label="@T.T("common.branch")"
                           Variant="Variant.Outlined" Required="true" Disabled="IsEdit">
                    @foreach (var branch in Branches)
                    {
                        <MudSelectItem T="Guid" Value="@branch.Id">@branch.NameAr</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_input.Code" Label="@T.T("common.code")" Required="true"
                              Variant="Variant.Outlined" MaxLength="30" />
                <MudTextField @bind-Value="_input.NameAr" Label="@T.T("common.name_ar")"
                              Required="true" Variant="Variant.Outlined" MaxLength="150" />
                <MudTextField @bind-Value="_input.NameEn" Label="@T.T("common.name_en")"
                              Variant="Variant.Outlined" MaxLength="150" />
                <MudSelect T="string" @bind-Value="_input.TreasuryType" Label="@T.T("treasury.type")"
                           Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@TreasuryTypes.Cash">@T.T("treasury.type_cash")</MudSelectItem>
                    <MudSelectItem T="string" Value="@TreasuryTypes.Bank">@T.T("treasury.type_bank")</MudSelectItem>
                    <MudSelectItem T="string" Value="@TreasuryTypes.Wallet">@T.T("treasury.type_wallet")</MudSelectItem>
                </MudSelect>
                <MudSelect T="Guid" @bind-Value="_input.AccountId" Label="@T.T("treasury.account")"
                           Variant="Variant.Outlined" Required="true">
                    @foreach (var account in _accounts)
                    {
                        <MudSelectItem T="Guid" Value="@account.Id">
                            @account.Code — @account.DisplayName(_english)
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField @bind-Value="_input.OpeningBalance" Label="@T.T("treasury.opening_balance")"
                                 Variant="Variant.Outlined" Min="0m" Format="N2" />
                <MudNumericField @bind-Value="_input.CollectionFeePercent"
                                 Label="@T.T("treasury.customer_collection_fee_percent")"
                                 Variant="Variant.Outlined" Min="0" Max="100" Format="N2" />
                <MudSelect T="Guid?" @bind-Value="_input.CollectionFeeAccountId" Clearable="true"
                           Label="@T.T("treasury.customer_collection_fee_account")"
                           Variant="Variant.Outlined">
                    @foreach (var account in _accounts)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)account.Id)">
                            @account.Code — @account.DisplayName(_english)
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudSwitch T="bool" @bind-Value="_input.FollowInShift" Color="Color.Success"
                           Label="@T.T("treasury.follow_in_shift")" />
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">@T.T("common.cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync"
                   Disabled="_busy">@T.T("common.save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public IReadOnlyList<Branch> Branches { get; set; } = Array.Empty<Branch>();
    [Parameter] public Guid? DefaultBranchId { get; set; }
    [Parameter] public Treasury? Model { get; set; }

    [Inject] private TreasuryService Treasury { get; set; } = default!;
    [Inject] private UserContext UserContext { get; set; } = default!;
    [Inject] private UiCulture T { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudForm _form = default!;
    private TreasuryInput _input = new();
    private IReadOnlyList<Account> _accounts = Array.Empty<Account>();
    private bool _busy;
    private bool _english;

    private bool IsEdit => Model is not null;

    protected override async Task OnInitializedAsync()
    {
        _english = T.Language == "en";
        if (Model is null)
        {
            _input.BranchId = DefaultBranchId ?? Branches.FirstOrDefault()?.Id ?? Guid.Empty;
        }
        else
        {
            _input = new TreasuryInput
            {
                BranchId = Model.BranchId, Code = Model.Code, NameAr = Model.NameAr,
                NameEn = Model.NameEn, TreasuryType = Model.TreasuryType,
                AccountId = Model.AccountId, OpeningBalance = Model.OpeningBalance,
                OverShortAccountId = Model.OverShortAccountId,
                CollectionFeePercent = Model.CollectionFeePercent,
                CollectionFeeAccountId = Model.CollectionFeeAccountId,
                ProviderFeePercent = Model.ProviderFeePercent,
                ProviderFeeAmount = Model.ProviderFeeAmount,
                ProviderFeeAccountId = Model.ProviderFeeAccountId,
                FollowInShift = Model.FollowInShift
            };
        }

        var actor = await UserContext.GetAsync();
        if (actor is not null) _accounts = await Treasury.PostableAccountsAsync(actor);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        _busy = true;
        try
        {
            var actor = await UserContext.RequireAsync();
            if (Model is null)
            {
                var saved = await Treasury.CreateTreasuryAsync(actor, _input);
                MudDialog.Close(DialogResult.Ok(saved));
            }
            else
            {
                await Treasury.UpdateTreasuryAsync(actor, Model.Id, _input);
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        catch (AppException ex) { Snackbar.Add(T.T(ex.Code), Severity.Error); }
        finally { _busy = false; }
    }
}
