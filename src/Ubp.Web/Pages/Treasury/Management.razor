@page "/treasury/management"
@attribute [Authorize]
@inherits SecurePageBase
@inject TreasuryService Treasury
@inject BranchService Branches
@inject IDialogService Dialogs
<PageTitle>@T.T("screen.treasuries")</PageTitle>

@if (Denied) { <ForbiddenView /> }
else if (Loading) { <div class="ubp-loading"><MudProgressCircular Indeterminate="true" /></div> }
else
{
    <PageHeader Title="@T.T("screen.treasuries")" Subtitle="@T.T("treasury.management_hint")">
        <Actions>
            @if (Can(ActionCodes.Create))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">@T.T("common.add")</MudButton>
            }
        </Actions>
    </PageHeader>

    <MudPaper Elevation="0" Class="ubp-card">
        <div class="ubp-toolbar">
            <MudSelect ToStringFunc="@BranchLabel" T="Guid?" Value="_branchId" Label="@T.T("common.branch")"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       ValueChanged="OnBranchChanged">
                @foreach (var branch in _branches)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)branch.Id)">@branch.NameAr</MudSelectItem>
                }
            </MudSelect>
            <MudSwitch T="bool" Value="_includeArchived" Color="Color.Warning"
                       Label="@T.T("treasury.show_archived")"
                       ValueChanged="OnIncludeArchivedChanged" />
        </div>

        <MudTable Items="_items" Dense="true" Hover="true" Striped="true" Elevation="0"
                  RowsPerPage="25" Class="ubp-table">
            <HeaderContent>
                <MudTh>@T.T("common.code")</MudTh>
                <MudTh>@T.T("common.name_ar")</MudTh>
                <MudTh>@T.T("treasury.type")</MudTh>
                <MudTh>@T.T("treasury.account")</MudTh>
                <MudTh Align="Right">@T.T("treasury.opening_balance")</MudTh>
                <MudTh>@T.T("treasury.follow_in_shift")</MudTh>
                <MudTh Align="Right">@T.T("common.actions")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><span class="ubp-code">@context.Code</span></MudTd>
                <MudTd>
                    @context.DisplayName(IsEnglish)
                    @if (!context.IsActive)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ms-2">
                            @T.T("treasury.archived")
                        </MudChip>
                    }
                </MudTd>
                <MudTd>@T.T("treasury.type_" + context.TreasuryType)</MudTd>
                <MudTd>@context.AccountCode — @context.AccountName</MudTd>
                <MudTd Align="Right">@context.OpeningBalance.ToString("N2")</MudTd>
                <MudTd>
                    @if (context.IsActive && Can(ActionCodes.ManageMethods))
                    {
                        <MudSwitch T="bool" Value="context.FollowInShift" Color="Color.Success"
                                   ValueChanged="@(v => ToggleFollowAsync(context, v))" />
                    }
                    else
                    {
                        <MudText>@(context.FollowInShift ? "✓" : "—")</MudText>
                    }
                </MudTd>
                <MudTd Align="Right">
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true"
                             AnchorOrigin="Origin.BottomRight">
                        @if (context.IsActive && Can(ActionCodes.Edit))
                        {
                            <MudMenuItem OnClick="@(() => EditAsync(context))"
                                         Icon="@Icons.Material.Filled.Edit">
                                @T.T("common.edit")
                            </MudMenuItem>
                            <MudMenuItem OnClick="@(() => SettingsAsync(context))"
                                         Icon="@Icons.Material.Filled.Settings">
                                @T.T("treasury.settings_menu")
                            </MudMenuItem>
                        }
                        @if (context.IsActive && Can(ActionCodes.Delete))
                        {
                            <MudMenuItem OnClick="@(() => ArchiveAsync(context))"
                                         Icon="@Icons.Material.Filled.Archive">
                                @T.T("treasury.archive")
                            </MudMenuItem>
                        }
                        @if (!context.IsActive && Can(ActionCodes.Edit))
                        {
                            <MudMenuItem OnClick="@(() => RestoreAsync(context))"
                                         Icon="@Icons.Material.Filled.Unarchive">
                                @T.T("treasury.restore")
                            </MudMenuItem>
                        }
                    </MudMenu>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private IReadOnlyList<Treasury> _items = Array.Empty<Treasury>();
    private IReadOnlyList<Branch> _branches = Array.Empty<Branch>();
    private Guid? _branchId;
    private bool _includeArchived;

    private bool IsEnglish => T.Language == "en";

    protected override string ScreenCode => ScreenCodes.Treasuries;

    protected override async Task OnLoadAsync()
    {
        _branches = await Branches.OptionsAsync(Actor!);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _items = await Treasury.ListTreasuriesAsync(Actor!, _branchId, _includeArchived);
    }

    private Task OnBranchChanged(Guid? value)
    {
        _branchId = value;
        return RunAsync(ReloadAsync);
    }

    private Task OnIncludeArchivedChanged(bool value)
    {
        _includeArchived = value;
        return RunAsync(ReloadAsync);
    }

    private async Task AddAsync()
    {
        var dialog = await Dialogs.ShowAsync<TreasuryDialog>(T.T("screen.treasuries"),
            new DialogParameters
            {
                ["Branches"] = _branches, ["DefaultBranchId"] = _branchId
            });
        if ((await dialog.Result) is { Canceled: false })
        {
            await RunAsync(ReloadAsync);
            ShowSuccess("common.saved");
        }
    }

    private async Task EditAsync(Treasury treasury)
    {
        var dialog = await Dialogs.ShowAsync<TreasuryDialog>(T.T("treasury.edit_treasury"),
            new DialogParameters
            {
                ["Branches"] = _branches, ["DefaultBranchId"] = _branchId, ["Model"] = treasury
            });
        if ((await dialog.Result) is { Canceled: false })
        {
            await RunAsync(ReloadAsync);
            ShowSuccess("common.saved");
        }
    }

    private async Task SettingsAsync(Treasury treasury)
    {
        var dialog = await Dialogs.ShowAsync<TreasurySettingsDialog>(
            T.T("treasury.settings_menu"),
            new DialogParameters { ["Treasury"] = treasury });
        if ((await dialog.Result) is { Canceled: false })
        {
            await RunAsync(ReloadAsync);
            ShowSuccess("common.saved");
        }
    }

    private async Task ArchiveAsync(Treasury treasury)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(T.T("treasury.archive_confirm"),
            $"{treasury.Code} — {treasury.DisplayName(IsEnglish)}",
            yesText: T.T("treasury.archive"), cancelText: T.T("common.cancel"));
        if (confirmed != true) return;

        await RunAsync(async () =>
        {
            await Treasury.ArchiveTreasuryAsync(Actor!, treasury.Id);
            await ReloadAsync();
            ShowSuccess("common.saved");
        });
    }

    private Task RestoreAsync(Treasury treasury) => RunAsync(async () =>
    {
        await Treasury.RestoreTreasuryAsync(Actor!, treasury.Id);
        await ReloadAsync();
        ShowSuccess("common.saved");
    });

    private Task ToggleFollowAsync(Treasury treasury, bool followInShift) => RunAsync(async () =>
    {
        await Treasury.SetTreasuryFollowInShiftAsync(Actor!, treasury.Id, followInShift);
        await ReloadAsync();
        ShowSuccess("common.saved");
    });

    private string BranchLabel(Guid? id) =>
        id is null ? "—" : _branches.FirstOrDefault(b => b.Id == id)?.NameAr ?? "—";
}
