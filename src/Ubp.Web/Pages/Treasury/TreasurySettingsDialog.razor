@inherits ComponentBase

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@T.T("treasury.settings_menu") — @Treasury.DisplayName(_english)</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle2" Class="mb-2">@T.T("treasury.shift_follow")</MudText>
        <MudSwitch T="bool" @bind-Value="_followInShift" Color="Color.Success"
                   Label="@T.T("treasury.follow_in_shift")" />
        <MudText Typo="Typo.caption" Class="ubp-muted mb-3">
            @T.T("treasury.follow_in_shift_hint")
        </MudText>

        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">@T.T("treasury.provider_fee_section")</MudText>
        <div class="ubp-form-grid">
            <MudNumericField @bind-Value="_providerFeePercent"
                             Label="@T.T("treasury.provider_fee_percent")"
                             Variant="Variant.Outlined" Min="0" Max="100" Format="N2" />
            <MudNumericField @bind-Value="_providerFeeAmount"
                             Label="@T.T("treasury.provider_fee_amount")"
                             Variant="Variant.Outlined" Min="0" Format="N2" />
            <MudSelect T="Guid?" @bind-Value="_providerFeeAccountId" Clearable="true"
                       Label="@T.T("treasury.provider_fee_account")" Variant="Variant.Outlined"
                       HelperText="@T.T("treasury.provider_fee_hint")">
                @foreach (var account in _accounts)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)account.Id)">
                        @account.Code — @account.DisplayName(_english)
                    </MudSelectItem>
                }
            </MudSelect>
        </div>

        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">@T.T("treasury.over_short_section")</MudText>
        <MudSelect T="Guid?" @bind-Value="_overShortAccountId" Clearable="true"
                   Label="@T.T("treasury.over_short_account")" Variant="Variant.Outlined"
                   HelperText="@T.T("treasury.over_short_account_hint")">
            @foreach (var account in _accounts)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)account.Id)">
                    @account.Code — @account.DisplayName(_english)
                </MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">@T.T("common.cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync"
                   Disabled="_busy">@T.T("common.save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Treasury Treasury { get; set; } = default!;

    [Inject] private TreasuryService Service { get; set; } = default!;
    [Inject] private UserContext UserContext { get; set; } = default!;
    [Inject] private UiCulture T { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private IReadOnlyList<Account> _accounts = Array.Empty<Account>();
    private Guid? _overShortAccountId;
    private Guid? _providerFeeAccountId;
    private decimal _providerFeePercent;
    private decimal _providerFeeAmount;
    private bool _followInShift;
    private bool _busy;
    private bool _english;

    protected override async Task OnInitializedAsync()
    {
        _english = T.Language == "en";
        _overShortAccountId = Treasury.OverShortAccountId;
        _providerFeePercent = Treasury.ProviderFeePercent;
        _providerFeeAmount = Treasury.ProviderFeeAmount;
        _providerFeeAccountId = Treasury.ProviderFeeAccountId;
        _followInShift = Treasury.FollowInShift;
        try
        {
            var actor = await UserContext.RequireAsync();
            _accounts = await Service.PostableAccountsAsync(actor);
        }
        catch (AppException ex) { Snackbar.Add(T.T(ex.Code), Severity.Error); }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            var actor = await UserContext.RequireAsync();
            await Service.SetTreasuryOverShortAccountAsync(actor, Treasury.Id, _overShortAccountId);
            await Service.SetProviderFeeAsync(actor, Treasury.Id, _providerFeePercent,
                _providerFeeAmount, _providerFeeAccountId);
            await Service.SetTreasuryFollowInShiftAsync(actor, Treasury.Id, _followInShift);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (AppException ex) { Snackbar.Add(T.T(ex.Code), Severity.Error); }
        finally { _busy = false; }
    }
}
