@inherits ComponentBase

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@T.T("treasury.over_short_account") — @Treasury.DisplayName(_english)</MudText>
    </TitleContent>
    <DialogContent>
        <MudSelect T="Guid?" @bind-Value="_accountId" Clearable="true"
                   Label="@T.T("treasury.over_short_account")" Variant="Variant.Outlined"
                   HelperText="@T.T("treasury.over_short_account_hint")">
            @foreach (var account in _accounts)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)account.Id)">
                    @account.Code — @account.DisplayName(_english)
                </MudSelectItem>
            }
        </MudSelect>

        <MudNumericField @bind-Value="_feePercent" Label="@T.T("treasury.collection_fee_percent")"
                         Variant="Variant.Outlined" Min="0" Max="100" Format="N2" Class="mt-3" />
        <MudSelect T="Guid?" @bind-Value="_feeAccountId" Clearable="true" Class="mt-3"
                   Label="@T.T("treasury.collection_fee_account")" Variant="Variant.Outlined"
                   HelperText="@T.T("treasury.collection_fee_hint")">
            @foreach (var account in _accounts)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)account.Id)">
                    @account.Code — @account.DisplayName(_english)
                </MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">@T.T("common.cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync"
                   Disabled="_busy">@T.T("common.save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Treasury Treasury { get; set; } = default!;

    [Inject] private TreasuryService Service { get; set; } = default!;
    [Inject] private UserContext UserContext { get; set; } = default!;
    [Inject] private UiCulture T { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private IReadOnlyList<Account> _accounts = Array.Empty<Account>();
    private Guid? _accountId;
    private Guid? _feeAccountId;
    private decimal _feePercent;
    private bool _busy;
    private bool _english;

    protected override async Task OnInitializedAsync()
    {
        _english = T.Language == "en";
        _accountId = Treasury.OverShortAccountId;
        _feePercent = Treasury.CollectionFeePercent;
        _feeAccountId = Treasury.CollectionFeeAccountId;
        try
        {
            var actor = await UserContext.RequireAsync();
            _accounts = await Service.PostableAccountsAsync(actor);
        }
        catch (AppException ex) { Snackbar.Add(T.T(ex.Code), Severity.Error); }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            var actor = await UserContext.RequireAsync();
            await Service.SetTreasuryOverShortAccountAsync(actor, Treasury.Id, _accountId);
            await Service.SetCollectionFeeAsync(actor, Treasury.Id, _feePercent, _feeAccountId);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (AppException ex) { Snackbar.Add(T.T(ex.Code), Severity.Error); }
        finally { _busy = false; }
    }
}
