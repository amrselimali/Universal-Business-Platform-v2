@inherits ComponentBase

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@T.T("treasury.close_shift") — @Shift.Code</MudText>
    </TitleContent>
    <DialogContent>
        <div class="ubp-toolbar">
            <MudText>@T.T("treasury.treasury"): <b>@Shift.TreasuryName</b></MudText>
            <MudText>@T.T("treasury.opening_cash"): <b>@Shift.OpeningCash.ToString("N2")</b></MudText>
            <MudText>@T.T("treasury.expected_cash"): <b>@Shift.ExpectedCash.ToString("N2")</b></MudText>
        </div>

        <MudTable Items="_denominations" Dense="true" Elevation="0" Class="ubp-table my-2">
            <HeaderContent>
                <MudTh>@T.T("treasury.denomination")</MudTh>
                <MudTh>@T.T("treasury.count")</MudTh>
                <MudTh Align="Right">@T.T("accounting.total")</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudNumericField T="decimal" Value="context.Denomination" Min="0m" Format="N2"
                                     Dense="true" ValueChanged="@(v => context.Denomination = v)" />
                </MudTd>
                <MudTd>
                    <MudNumericField T="int" Value="context.Count" Min="0" Dense="true"
                                     ValueChanged="@(v => context.Count = v)" />
                </MudTd>
                <MudTd Align="Right">@(context.Denomination * context.Count).ToString("N2")</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                   OnClick="@(() => _denominations.Remove(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>

        <div class="ubp-toolbar">
            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddDenomination">@T.T("treasury.add_denomination")</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Text"
                       OnClick="UseCounted">@T.T("treasury.use_denomination_total")</MudButton>
            <MudText>@T.T("treasury.denomination_total"): <b>@DenominatedTotal.ToString("N2")</b></MudText>
        </div>

        <MudNumericField @bind-Value="_counted" Label="@T.T("treasury.counted_cash")"
                         Variant="Variant.Outlined" Min="0m" Format="N2" Class="mt-2" />

        <MudAlert Severity="@(Variance < 0 ? Severity.Warning : (Variance > 0 ? Severity.Info : Severity.Normal))"
                  Dense="true" Class="mt-2">
            @T.T("treasury.variance"): @Variance.ToString("N2")
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">@T.T("common.cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmAsync"
                   Disabled="_busy">@T.T("treasury.close_shift")</MudButton>
    </DialogActions>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Shift Shift { get; set; } = default!;

    [Inject] private TreasuryService Treasury { get; set; } = default!;
    [Inject] private UserContext UserContext { get; set; } = default!;
    [Inject] private UiCulture T { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private List<ShiftDenominationInput> _denominations = new();
    private decimal _counted;
    private bool _busy;

    private decimal DenominatedTotal =>
        Math.Round(_denominations.Sum(d => d.Denomination * d.Count), 2,
            MidpointRounding.AwayFromZero);

    private decimal Variance =>
        Math.Round(_counted - Shift.ExpectedCash, 2, MidpointRounding.AwayFromZero);

    protected override void OnInitialized()
    {
        _denominations = Shift.Denominations
            .Select(d => new ShiftDenominationInput { Denomination = d.Denomination, Count = d.Count })
            .ToList();
        _counted = Shift.CountedCash ?? Shift.ExpectedCash;
    }

    private void AddDenomination()
    {
        _denominations.Add(new ShiftDenominationInput());
        StateHasChanged();
    }

    private void UseCounted() => _counted = DenominatedTotal;

    private void Cancel() => MudDialog.Cancel();

    private async Task ConfirmAsync()
    {
        _busy = true;
        try
        {
            var actor = await UserContext.RequireAsync();
            var denominations = _denominations
                .Where(d => d.Denomination > 0 && d.Count > 0)
                .ToList();
            if (denominations.Count > 0)
                await Treasury.SaveDenominationsAsync(actor, Shift.Id, denominations);

            var closed = await Treasury.CloseShiftAsync(actor, Shift.Id, _counted);
            MudDialog.Close(DialogResult.Ok(closed));
        }
        catch (AppException ex) { Snackbar.Add(T.T(ex.Code), Severity.Error); }
        finally { _busy = false; }
    }
}

</MudDialog>
