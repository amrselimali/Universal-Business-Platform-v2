@inherits ComponentBase

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@T.T("treasury.open_shift")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <div class="ubp-form-grid">
                <MudSelect T="Guid" Value="_input.BranchId" Label="@T.T("common.branch")"
                           Variant="Variant.Outlined" ValueChanged="OnBranchChanged">
                    @foreach (var branch in Branches)
                    {
                        <MudSelectItem T="Guid" Value="@branch.Id">@branch.NameAr</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_input.Notes" Label="@T.T("common.notes")"
                              Variant="Variant.Outlined" MaxLength="500" />
            </div>
        </MudForm>

        @if (_balances is not null)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-3">@T.T("treasury.shift_followed_treasuries")</MudText>
            <MudTable Items="_balances.Treasuries" Dense="true" Elevation="0" Class="ubp-table">
                <HeaderContent>
                    <MudTh>@T.T("treasury.treasury")</MudTh>
                    <MudTh Align="Right">@T.T("treasury.opening_balance")</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><span class="ubp-code">@context.Code</span> — @context.NameAr</MudTd>
                    <MudTd Align="Right"><b>@context.Total.ToString("N2")</b></MudTd>
                </RowTemplate>
            </MudTable>

            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                @T.T("treasury.opening_cash_locked")
            </MudAlert>

            <MudText Typo="Typo.subtitle2" Class="mt-3">@T.T("treasury.meter_balance")</MudText>
            @if (_balances.Meters.Count == 0)
            {
                <MudText Typo="Typo.caption">@T.T("treasury.no_meters")</MudText>
            }
            else
            {
                <MudGrid Spacing="2">
                    @foreach (var meter in _balances.Meters)
                    {
                        <MudItem xs="6" sm="4" md="3">
                            <MudPaper Outlined="true" Class="pa-2">
                                <MudText Typo="Typo.caption">@meter.Code — @meter.NameAr</MudText>
                                <MudText Typo="Typo.body1"><b>@meter.Value.ToString("N2")</b></MudText>
                                <MudText Typo="Typo.caption">@meter.MeterType</MudText>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }
        }
        else
        {
            <div class="ubp-loading"><MudProgressCircular Indeterminate="true" /></div>
        }

        @if (_openShift is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                @T.T("validation.shift_already_open") — @_openShift.Code
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">@T.T("common.cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync"
                   Disabled="@(_busy || _balances is null || _openShift is not null)">
            @T.T("common.save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public IReadOnlyList<Branch> Branches { get; set; } = Array.Empty<Branch>();
    [Parameter] public Guid? DefaultBranchId { get; set; }

    [Inject] private TreasuryService Treasury { get; set; } = default!;
    [Inject] private UserContext UserContext { get; set; } = default!;
    [Inject] private UiCulture T { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudForm _form = default!;
    private ShiftInput _input = new();
    private ShiftOpeningBalances? _balances;
    private Shift? _openShift;
    private bool _busy;

    private string PendingReviewHint => _balances is null
        ? ""
        : string.Format(T.T("treasury.pending_review_shifts"), _balances.PendingReviewShifts);

    protected override async Task OnInitializedAsync()
    {
        _input.BranchId = DefaultBranchId ?? Branches.FirstOrDefault()?.Id ?? Guid.Empty;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _balances = null;
        _openShift = null;
        if (_input.BranchId == Guid.Empty) return;

        try
        {
            var actor = await UserContext.RequireAsync();
            _balances = await Treasury.GetOpeningBalancesAsync(actor, _input.BranchId);
            _openShift = await Treasury.GetOpenShiftAsync(actor, _input.BranchId);
        }
        catch (AppException ex) { Snackbar.Add(T.T(ex.Code), Severity.Error); }
        finally { StateHasChanged(); }
    }

    private Task OnBranchChanged(Guid value)
    {
        _input.BranchId = value;
        return LoadAsync();
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_form.IsValid || _input.BranchId == Guid.Empty)
        {
            Snackbar.Add(T.T("validation.required_fields"), Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var actor = await UserContext.RequireAsync();
            var shift = await Treasury.OpenShiftAsync(actor, _input);
            MudDialog.Close(DialogResult.Ok(shift));
        }
        catch (AppException ex) { Snackbar.Add(T.T(ex.Code), Severity.Error); }
        finally { _busy = false; }
    }
}

