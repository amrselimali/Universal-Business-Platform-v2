@inherits ComponentBase

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@T.T("treasury.review_shift") — @Shift.Code</MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
            @T.T("treasury.review_hint")
        </MudAlert>

        <MudTable Items="_items" Dense="true" Elevation="0" Class="ubp-table">
            <HeaderContent>
                <MudTh>@T.T("common.screen")</MudTh>
                <MudTh>@T.T("treasury.doc_no")</MudTh>
                <MudTh>@T.T("common.date")</MudTh>
                <MudTh>@T.T("common.party")</MudTh>
                <MudTh Align="Right">المبلغ/الكمية المعدّلة</MudTh>
                <MudTh>ملاحظة المراجعة</MudTh>
                <MudTh>@T.T("treasury.review_status")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@T.T("screen." + context.ScreenCode.ToLowerInvariant())</MudTd>
                <MudTd>@context.DocNo</MudTd>
                <MudTd>@(context.DocDate is null ? "—" : context.DocDate.Value.ToString("d"))</MudTd>
                <MudTd>@context.PartyName</MudTd>
                <MudTd Align="Right">
                    @if (IsAmountEditable(context.EntityType))
                    {
                        <MudNumericField T="decimal" @bind-Value="_amounts[context.Id]" Min="0m"
                                         Format="N2" Dense="true" />
                    }
                    else if (IsQtyEditable(context.EntityType))
                    {
                        <MudNumericField T="decimal" @bind-Value="_qtys[context.Id]" Min="0m"
                                         Format="N4" Dense="true" Placeholder="الكمية" />
                    }
                    else
                    {
                        @context.Amount.ToString("N2")
                    }
                </MudTd>
                <MudTd>
                    <MudTextField T="string" @bind-Value="_notes[context.Id]" Dense="true"
                                  Immediate="false" Placeholder="ملاحظة" />
                </MudTd>
                <MudTd>@T.T("treasury.review_" + context.Status)</MudTd>
            </RowTemplate>
        </MudTable>

        <MudText Typo="Typo.body2" Class="mt-2">
            @string.Format(T.T("treasury.review_pending_count"), PendingCount)
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">@T.T("common.cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmAsync"
                   Disabled="@_busy">@T.T("treasury.approve_review")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Shift Shift { get; set; } = default!;

    [Inject] private TreasuryService Treasury { get; set; } = default!;
    [Inject] private ReviewAdjustmentService ReviewAdjustments { get; set; } = default!;
    [Inject] private UserContext UserContext { get; set; } = default!;
    [Inject] private UiCulture T { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private IReadOnlyList<ShiftReviewItem> _items = Array.Empty<ShiftReviewItem>();
    private readonly Dictionary<Guid, decimal> _amounts = new();
    private readonly Dictionary<Guid, decimal> _qtys = new();
    private readonly Dictionary<Guid, string> _notes = new();
    private bool _busy;

    private static bool IsAmountEditable(string entityType) =>
        entityType is "voucher" or "operating_expense";

    private static bool IsQtyEditable(string entityType) => entityType is "service_transfer";

    private int PendingCount => _items.Count(i => i.Status == ShiftReviewStatuses.Pending);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var actor = await UserContext.RequireAsync();
            _items = await Treasury.ListReviewItemsAsync(actor, Shift.Id);
            foreach (var item in _items)
            {
                _amounts[item.Id] = item.Amount;
                _qtys[item.Id] = 0;
                _notes[item.Id] = "";
            }
        }
        catch (AppException ex) { Snackbar.Add(T.T(ex.Code), Severity.Error); }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task ConfirmAsync()
    {
        _busy = true;
        try
        {
            var actor = await UserContext.RequireAsync();

            // تسجيل تعديلات المراجعة (المبلغ والملاحظة) قبل الاعتماد؛ تُطبَّق بقيد الفرق — 0084.
            foreach (var item in _items)
            {
                var note = _notes.TryGetValue(item.Id, out var n) ? n : null;
                if (IsAmountEditable(item.EntityType))
                {
                    var newAmount = _amounts.TryGetValue(item.Id, out var a) ? a : item.Amount;
                    if (newAmount == item.Amount && string.IsNullOrWhiteSpace(note)) continue;
                    await ReviewAdjustments.RecordAsync(actor, new ReviewAdjustmentInput
                    {
                        ShiftId = Shift.Id, EntityType = item.EntityType, EntityId = item.EntityId,
                        Field = ReviewAdjustmentRules.Amount,
                        NewValue = newAmount.ToString(
                            System.Globalization.CultureInfo.InvariantCulture),
                        Note = string.IsNullOrWhiteSpace(note) ? null : note
                    });
                }
                else if (IsQtyEditable(item.EntityType))
                {
                    var qty = _qtys.TryGetValue(item.Id, out var q) ? q : 0m;
                    if (qty <= 0) continue;
                    await ReviewAdjustments.RecordAsync(actor, new ReviewAdjustmentInput
                    {
                        ShiftId = Shift.Id, EntityType = item.EntityType, EntityId = item.EntityId,
                        Field = ReviewAdjustmentRules.Quantity,
                        NewValue = qty.ToString(
                            System.Globalization.CultureInfo.InvariantCulture),
                        Note = string.IsNullOrWhiteSpace(note) ? null : note
                    });
                }
            }

            var reviewed = await Treasury.ReviewShiftAsync(actor, Shift.Id);
            MudDialog.Close(DialogResult.Ok(reviewed));
        }
        catch (AppException ex) { Snackbar.Add(T.T(ex.Code), Severity.Error); }
        finally { _busy = false; }
    }
}
