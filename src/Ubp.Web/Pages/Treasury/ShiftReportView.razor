@inject IDisplayFormatter Fmt

<div class="ubp-shift-report">
    <div class="ubp-shift-report-head">
        <div class="ubp-shift-report-title">
            @T.T("treasury.shift_report") — @Report.Shift.Code
        </div>
        <div class="ubp-shift-report-meta">
            <span>@T.T("common.branch"): @Report.Shift.BranchName</span>
            <span>@T.T("treasury.opened_at"): @Fmt.DateTime(Report.Shift.OpenedAt)</span>
            <span>
                @T.T("treasury.closed_at"): @(Report.Shift.ClosedAt is null
                    ? "—" : Fmt.DateTime(Report.Shift.ClosedAt.Value))
            </span>
            <span>@T.T("treasury.user"): @Report.Shift.Username</span>
            @if (!string.IsNullOrWhiteSpace(Report.Shift.ClosedByName))
            {
                <span>@T.T("treasury.closed_by_user"): @Report.Shift.ClosedByName</span>
            }
        </div>
    </div>

    @if (!PrintMode)
    {
        <div class="ubp-toolbar ubp-print-hide">
            <MudText Typo="Typo.subtitle2">
                @T.T("treasury.report_collections") / @T.T("treasury.report_revenues")
            </MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PictureAsPdf"
                       OnClick="ExportPdfAsync">@T.T("treasury.export_pdf")</MudButton>
            @if (_saving)
            {
                <MudText Typo="Typo.caption" Class="ubp-muted">@T.T("common.saving")</MudText>
            }
        </div>
    }

    <MudTable Items="Report.Lines" Dense="true" Elevation="0" Class="ubp-table">
        <HeaderContent>
            <MudTh>العميل</MudTh>
            <MudTh>مصدر الحركة</MudTh>
            <MudTh>الصنف / الخدمة</MudTh>
            <MudTh>الخزينة / الدفع</MudTh>
            <MudTh Align="Right">المبلغ المحصّل</MudTh>
            <MudTh Align="Right">قيمة الإيراد</MudTh>
            <MudTh Align="Right">سعر الوحدة</MudTh>
            <MudTh Align="Right">الكمية</MudTh>
            <MudTh Align="Right">@MeterUnitsLabel</MudTh>
            <MudTh>منفذ الخدمة</MudTh>
            <MudTh>متسبب الشكوى</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.CustomerName</MudTd>
            <MudTd>
                @if (!string.IsNullOrWhiteSpace(context.Source))
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@SourceColor(context.Source)">@context.Source</MudChip>
                }
            </MudTd>
            <MudTd>@context.ItemName</MudTd>
            <MudTd>@TreasuryTypeText(context.TreasuryType)</MudTd>
            <MudTd Align="Right">@context.Collected.ToString("N2")</MudTd>
            <MudTd Align="Right">@context.Revenue.ToString("N2")</MudTd>
            <MudTd Align="Right">@(context.UnitPrice == 0 ? "—" : context.UnitPrice.ToString("N2"))</MudTd>
            <MudTd Align="Right">@context.Quantity.ToString("N2")</MudTd>
            <MudTd Align="Right">@context.MeterUnits.ToString("N2")</MudTd>
            <MudTd>@context.EmployeeName</MudTd>
            <MudTd>@context.ComplaintEmployeeName</MudTd>
        </RowTemplate>
    </MudTable>
    <MudText Typo="Typo.body2" Class="mt-1">
        @T.T("pos.collected_amount"): <b>@Report.CollectionsTotal.ToString("N2")</b> —
        @T.T("treasury.revenue_value"): <b>@Report.RevenuesTotal.ToString("N2")</b>
    </MudText>

    <MudDivider Class="my-2" />

    <MudText Typo="Typo.subtitle2" Class="mt-3">@T.T("expenses.title")</MudText>
    <MudTable Items="Report.Expenses" Dense="true" Elevation="0" Class="ubp-table">
        <HeaderContent>
            <MudTh>@T.T("treasury.type")</MudTh>
            <MudTh>@T.T("sales.item")</MudTh>
            <MudTh Align="Right">@T.T("common.quantity")</MudTh>
            <MudTh Align="Right">@T.T("inventory.unit_price")</MudTh>
            <MudTh Align="Right">@T.T("accounting.total")</MudTh>
            <MudTh>@T.T("common.notes")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@TreasuryTypeText(context.TreasuryType)</MudTd>
            <MudTd>@context.ItemName</MudTd>
            <MudTd Align="Right">@(context.ItemName is null ? "—" : context.Quantity.ToString("N2"))</MudTd>
            <MudTd Align="Right">@(context.ItemName is null ? "—" : context.UnitPrice.ToString("N2"))</MudTd>
            <MudTd Align="Right">@context.Amount.ToString("N2")</MudTd>
            <MudTd>@context.Description</MudTd>
        </RowTemplate>
    </MudTable>
    <MudText Typo="Typo.body2" Class="mt-1">
        @T.T("accounting.total"): <b>@Report.ExpensesTotal.ToString("N2")</b>
    </MudText>

    <MudDivider Class="my-2" />

    <MudText Typo="Typo.subtitle2" Class="mt-3">@T.T("treasury.meter_balance")</MudText>
    <MudTable Items="Report.Meters" Dense="true" Elevation="0" Class="ubp-table">
        <HeaderContent>
            <MudTh>@T.T("assets.meter")</MudTh>
            <MudTh Align="Right">@T.T("treasury.meter_opening")</MudTh>
            <MudTh Align="Right">@T.T("treasury.meter_consumed")</MudTh>
            <MudTh Align="Right">@T.T("treasury.meter_closing")</MudTh>
            <MudTh Align="Right">@T.T("treasury.meter_actual")</MudTh>
            <MudTh Align="Right">@T.T("treasury.variance")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Code — @context.NameAr</MudTd>
            <MudTd Align="Right">@context.Opening.ToString("N2")</MudTd>
            <MudTd Align="Right">@context.Consumed.ToString("N2")</MudTd>
            <MudTd Align="Right">@context.Closing.ToString("N2")</MudTd>
            <MudTd Align="Right">
                @if (Editable)
                {
                    <MudNumericField T="decimal" Value="context.Actual" Min="0m" Format="N2"
                                     Dense="true" ValueChanged="@(v => OnMeterChanged(context, v))" />
                }
                else
                {
                    <b>@context.Actual.ToString("N2")</b>
                }
            </MudTd>
            <MudTd Align="Right">
                <MudText Color="@(context.Variance < 0 ? Color.Error : Color.Default)">
                    @context.Variance.ToString("N2")
                </MudText>
            </MudTd>
        </RowTemplate>
    </MudTable>

    <MudDivider Class="my-2" />

    <MudText Typo="Typo.subtitle2" Class="mt-3">@T.T("treasury.cash_count")</MudText>
    <MudTable Items="Report.CashCounts" Dense="true" Elevation="0" Class="ubp-table">
        <HeaderContent>
            <MudTh>@T.T("treasury.treasury")</MudTh>
            <MudTh>@T.T("treasury.type")</MudTh>
            <MudTh Align="Right">@T.T("treasury.opening_period")</MudTh>
            <MudTh Align="Right">@T.T("treasury.expected_cash")</MudTh>
            <MudTh Align="Right">@T.T("treasury.counted_cash")</MudTh>
            <MudTh Align="Right">@T.T("treasury.variance")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.TreasuryCode — @context.TreasuryName</MudTd>
            <MudTd>@TreasuryTypeText(context.TreasuryType)</MudTd>
            <MudTd Align="Right">@context.OpeningCash.ToString("N2")</MudTd>
            <MudTd Align="Right">@context.ExpectedCash.ToString("N2")</MudTd>
            <MudTd Align="Right">
                @if (Editable)
                {
                    <MudNumericField T="decimal" Value="context.CountedCash ?? 0m" Min="0m" Format="N2"
                                     Dense="true"
                                     ValueChanged="@(v => OnCountedCashChanged(context, v))" />
                }
                else
                {
                    @(context.CountedCash?.ToString("N2") ?? "—")
                }
            </MudTd>
            <MudTd Align="Right">
                @(context.CountedCash is null
                    ? "—"
                    : Math.Round(context.CountedCash.Value - context.ExpectedCash, 2,
                        MidpointRounding.AwayFromZero).ToString("N2"))
            </MudTd>
        </RowTemplate>
    </MudTable>

    <MudDivider Class="my-2" />

    <MudText Typo="Typo.subtitle2" Class="mt-3">@T.T("common.notes")</MudText>
    <MudTextField T="string" Value="@Report.Notes" ValueChanged="OnNotesChanged" Immediate="true"
                  ReadOnly="@(!Editable)" Variant="Variant.Outlined" Lines="2" Class="mb-2" />

    <MudDivider Class="my-2" />

    <MudText Typo="Typo.body2" Class="mt-2">
        @T.T("treasury.report_idle_customers"): <b>@Report.IdleCustomersCount</b>
    </MudText>
    <MudText Typo="Typo.body2" Class="mt-1">
        @T.T("treasury.report_tomorrow_bookings_confirmed"): <b>@Report.TomorrowBookingsCount</b>
        —
        @T.T("treasury.report_tomorrow_bookings_unconfirmed"): <b>@Report.TomorrowBookingsUnconfirmedCount</b>
    </MudText>

    @if (Report.TomorrowAppointments.Count > 0)
    {
        <MudDivider Class="my-2" />
        <MudText Typo="Typo.subtitle2" Class="mt-3">
            @T.T("treasury.report_tomorrow_appointments") (@Report.TomorrowAppointments.Count)
        </MudText>
        <MudTable Items="Report.TomorrowAppointments" Dense="true" Elevation="0" Class="ubp-table">
            <HeaderContent>
                <MudTh>@T.T("common.employee")</MudTh>
                <MudTh>@T.T("sales.work_start_time")</MudTh>
                <MudTh>@T.T("sales.work_end_time")</MudTh>
                <MudTh>@T.T("common.status")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.EmployeeName</MudTd>
                <MudTd>@Fmt.DateTime(context.StartsAt)</MudTd>
                <MudTd>@Fmt.DateTime(context.EndsAt)</MudTd>
                <MudTd>@StatusText(context.Status)</MudTd>
            </RowTemplate>
        </MudTable>
    }
</div>

