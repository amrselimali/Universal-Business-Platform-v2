@inject UiCulture T
@inject IDisplayFormatter Fmt

<MudGrid Spacing="2" Class="mb-2">
    <MudItem xs="6" sm="3">
        <MudText Typo="Typo.caption">@T.T("treasury.carried_from_accounts")</MudText>
        <MudText Typo="Typo.body2"><b>@Report.Shift.CarriedBalance.ToString("N2")</b></MudText>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudText Typo="Typo.caption">@T.T("treasury.pending_review_balance")</MudText>
        <MudText Typo="Typo.body2"><b>@Report.Shift.ReviewBalance.ToString("N2")</b></MudText>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudText Typo="Typo.caption">@T.T("treasury.meter_balance")</MudText>
        <MudText Typo="Typo.body2"><b>@Report.Shift.MeterBalance.ToString("N2")</b></MudText>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudText Typo="Typo.caption">@T.T("treasury.opening_cash")</MudText>
        <MudText Typo="Typo.body2"><b>@Report.Shift.OpeningCash.ToString("N2")</b></MudText>
    </MudItem>
</MudGrid>

<MudExpansionPanels MultiExpansion="true" Elevation="0" Dense="true">
    <MudExpansionPanel Text="@($"{T.T("treasury.report_collections")} ({Report.Collections.Count})")">
        <MudTable Items="Report.Collections" Dense="true" Elevation="0" Class="ubp-table">
            <HeaderContent>
                <MudTh>@T.T("treasury.doc_no")</MudTh>
                <MudTh>@T.T("common.date")</MudTh>
                <MudTh>@T.T("common.party")</MudTh>
                <MudTh>@T.T("common.status")</MudTh>
                <MudTh Align="Right">@T.T("accounting.total")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.DocNo</MudTd>
                <MudTd>@Fmt.Date(context.DocDate)</MudTd>
                <MudTd>@context.PartyName</MudTd>
                <MudTd>@StatusText(context.Status)</MudTd>
                <MudTd Align="Right">@context.Amount.ToString("N2")</MudTd>
            </RowTemplate>
        </MudTable>
        <MudText Typo="Typo.body2" Class="mt-1">
            @T.T("accounting.total"): <b>@Report.CollectionsTotal.ToString("N2")</b>
        </MudText>
    </MudExpansionPanel>

    <MudExpansionPanel Text="@($"{T.T("treasury.report_revenues")} ({Report.Revenues.Count})")">
        <MudTable Items="Report.Revenues" Dense="true" Elevation="0" Class="ubp-table">
            <HeaderContent>
                <MudTh>@T.T("treasury.doc_no")</MudTh>
                <MudTh>@T.T("common.date")</MudTh>
                <MudTh>@T.T("common.party")</MudTh>
                <MudTh>@T.T("common.status")</MudTh>
                <MudTh Align="Right">@T.T("accounting.total")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.DocNo</MudTd>
                <MudTd>@Fmt.Date(context.DocDate)</MudTd>
                <MudTd>@context.PartyName</MudTd>
                <MudTd>@StatusText(context.Status)</MudTd>
                <MudTd Align="Right">@context.Amount.ToString("N2")</MudTd>
            </RowTemplate>
        </MudTable>
        <MudText Typo="Typo.body2" Class="mt-1">
            @T.T("accounting.total"): <b>@Report.RevenuesTotal.ToString("N2")</b>
        </MudText>
    </MudExpansionPanel>

    <MudExpansionPanel Text="@($"{T.T("treasury.report_movements")} ({Report.Movements.Count})")">
        <MudTable Items="Report.Movements" Dense="true" Elevation="0" Class="ubp-table">
            <HeaderContent>
                <MudTh>@T.T("treasury.doc_no")</MudTh>
                <MudTh>@T.T("treasury.voucher_type")</MudTh>
                <MudTh>@T.T("common.date")</MudTh>
                <MudTh>@T.T("treasury.treasury")</MudTh>
                <MudTh>@T.T("common.status")</MudTh>
                <MudTh Align="Right">@T.T("accounting.total")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.DocNo</MudTd>
                <MudTd>@T.T("treasury.voucher_" + context.DocType)</MudTd>
                <MudTd>@Fmt.Date(context.DocDate)</MudTd>
                <MudTd>@context.TreasuryName @(string.IsNullOrWhiteSpace(context.ToTreasuryName) ? "" : $"→ {context.ToTreasuryName}")</MudTd>
                <MudTd>@StatusText(context.Status)</MudTd>
                <MudTd Align="Right">
                    <MudText Color="@(context.Inflow ? Color.Success : Color.Error)">
                        @(context.Inflow ? "+" : "−")@context.Amount.ToString("N2")
                    </MudText>
                </MudTd>
            </RowTemplate>
        </MudTable>
        <MudText Typo="Typo.body2" Class="mt-1">
            @T.T("treasury.movement_in"): <b>@Report.MovementInTotal.ToString("N2")</b> —
            @T.T("treasury.movement_out"): <b>@Report.MovementOutTotal.ToString("N2")</b>
        </MudText>
    </MudExpansionPanel>

    <MudExpansionPanel Text="@($"{T.T("treasury.report_idle_customers")} ({Report.IdleCustomers.Count})")">
        <MudTable Items="Report.IdleCustomers" Dense="true" Elevation="0" Class="ubp-table">
            <HeaderContent>
                <MudTh>@T.T("common.code")</MudTh>
                <MudTh>@T.T("common.name")</MudTh>
                <MudTh>@T.T("common.phone")</MudTh>
                <MudTh>@T.T("treasury.last_activity")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><span class="ubp-code">@context.Code</span></MudTd>
                <MudTd>@context.NameAr</MudTd>
                <MudTd>@context.Phone</MudTd>
                <MudTd>
                    @(context.LastActivityAt is null
                        ? T.T("treasury.no_activity")
                        : $"{context.LastActivity} — {Fmt.Date(context.LastActivityAt.Value)}")
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudExpansionPanel>

    <MudExpansionPanel Text="@($"{T.T("treasury.report_tomorrow_bookings")} ({Report.TomorrowBookings.Count})")">
        <MudTable Items="Report.TomorrowBookings" Dense="true" Elevation="0" Class="ubp-table">
            <HeaderContent>
                <MudTh>@T.T("treasury.doc_no")</MudTh>
                <MudTh>@T.T("common.customer")</MudTh>
                <MudTh>@T.T("sales.booking_date")</MudTh>
                <MudTh>@T.T("common.employee")</MudTh>
                <MudTh>@T.T("common.status")</MudTh>
                <MudTh Align="Right">@T.T("accounting.total")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.DocNo</MudTd>
                <MudTd>@context.CustomerName</MudTd>
                <MudTd>
                    @Fmt.Date(context.BookingDate)
                    @(context.StartsAt is null ? "" : $" {Fmt.DateTime(context.StartsAt.Value)}")
                </MudTd>
                <MudTd>@context.EmployeeName</MudTd>
                <MudTd>@StatusText(context.Status)</MudTd>
                <MudTd Align="Right">@context.TotalAmount.ToString("N2")</MudTd>
            </RowTemplate>
        </MudTable>
    </MudExpansionPanel>

    <MudExpansionPanel Text="@($"{T.T("treasury.report_tomorrow_appointments")} ({Report.TomorrowAppointments.Count})")">
        <MudTable Items="Report.TomorrowAppointments" Dense="true" Elevation="0" Class="ubp-table">
            <HeaderContent>
                <MudTh>@T.T("common.employee")</MudTh>
                <MudTh>@T.T("common.customer")</MudTh>
                <MudTh>@T.T("sales.starts_at")</MudTh>
                <MudTh>@T.T("sales.ends_at")</MudTh>
                <MudTh>@T.T("common.status")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.EmployeeName</MudTd>
                <MudTd>@context.CustomerName</MudTd>
                <MudTd>@Fmt.DateTime(context.StartsAt)</MudTd>
                <MudTd>@Fmt.DateTime(context.EndsAt)</MudTd>
                <MudTd>@StatusText(context.Status)</MudTd>
            </RowTemplate>
        </MudTable>
    </MudExpansionPanel>

    <MudExpansionPanel Text="@($"{T.T("treasury.report_review_items")} ({Report.ReviewItems.Count})")">
        <MudTable Items="Report.ReviewItems" Dense="true" Elevation="0" Class="ubp-table">
            <HeaderContent>
                <MudTh>@T.T("common.screen")</MudTh>
                <MudTh>@T.T("treasury.doc_no")</MudTh>
                <MudTh>@T.T("common.date")</MudTh>
                <MudTh>@T.T("common.party")</MudTh>
                <MudTh Align="Right">@T.T("accounting.total")</MudTh>
                <MudTh>@T.T("treasury.review_status")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@T.T("screen." + context.ScreenCode.ToLowerInvariant())</MudTd>
                <MudTd>@context.DocNo</MudTd>
                <MudTd>@(context.DocDate is null ? "—" : Fmt.Date(context.DocDate.Value))</MudTd>
                <MudTd>@context.PartyName</MudTd>
                <MudTd Align="Right">@context.Amount.ToString("N2")</MudTd>
                <MudTd>@T.T("treasury.review_" + context.Status)</MudTd>
            </RowTemplate>
        </MudTable>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    [Parameter] public ShiftReport Report { get; set; } = new();

    private string StatusText(string status) => T.T(status switch
    {
        "draft" => "accounting.status_draft",
        "posted" => "accounting.status_posted",
        "cancelled" => "accounting.status_cancelled",
        "confirmed" => "sales.status_confirmed",
        "partially_delivered" => "sales.status_partial",
        "completed" => "sales.status_completed",
        "expired" => "sales.status_expired",
        "scheduled" => "sales.appointment_scheduled",
        "in_progress" => "sales.appointment_in_progress",
        "done" => "sales.appointment_done",
        "no_show" => "sales.appointment_no_show",
        _ => "accounting.status_" + status
    });
}

