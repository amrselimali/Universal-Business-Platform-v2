@inherits ComponentBase

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@T.T("expenses.cash_handover")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <div class="ubp-form-grid">
                <MudSelect T="Guid" Value="_treasuryId" Label="@T.T("treasury.treasury")"
                           Variant="Variant.Outlined" ValueChanged="OnTreasuryChanged" Required="true">
                    @foreach (var treasury in _treasuries)
                    {
                        <MudSelectItem T="Guid" Value="@treasury.Id">
                            @treasury.Code — @treasury.NameAr
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField @bind-Value="_amount" Label="@T.T("expenses.cash_handover_amount")"
                                 Variant="Variant.Outlined" Min="0.01m" Format="N2" Required="true" />
                @if (FollowInShift)
                {
                    <MudNumericField @bind-Value="_commission"
                                     Label="@T.T("expenses.handover_commission")"
                                     Variant="Variant.Outlined" Min="0m" Format="N2"
                                     HelperText="@T.T("expenses.handover_commission_hint")" />
                }
                <MudTextField @bind-Value="_notes" Label="@T.T("common.notes")"
                              Variant="Variant.Outlined" MaxLength="500" />
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">@T.T("common.cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync"
                   Disabled="_busy">@T.T("common.save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid BranchId { get; set; }

    [Inject] private TreasuryService Treasury { get; set; } = default!;
    [Inject] private LookupService Lookup { get; set; } = default!;
    [Inject] private UserContext UserContext { get; set; } = default!;
    [Inject] private UiCulture T { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudForm _form = default!;
    private IReadOnlyList<Core.Models.Treasury> _treasuries = Array.Empty<Core.Models.Treasury>();
    private Guid _treasuryId;
    private decimal _amount;
    private decimal _commission;
    private string? _notes;
    private bool _busy;
    private bool _english;

    private Core.Models.Treasury? Selected =>
        _treasuries.FirstOrDefault(t => t.Id == _treasuryId);

    /// <summary>عمولة التسليم تظهر فقط للخزائن المتابَعة في الشفت — 0093.</summary>
    private bool FollowInShift => Selected?.FollowInShift == true;

    protected override async Task OnInitializedAsync()
    {
        _english = T.Language == "en";
        try
        {
            var actor = await UserContext.RequireAsync();
            _treasuries = await Lookup.TreasuriesAsync(actor, BranchId);
            _treasuryId = _treasuries.FirstOrDefault()?.Id ?? Guid.Empty;
        }
        catch (AppException ex) { Snackbar.Add(T.T(ex.Code), Severity.Error); }
    }

    private void OnTreasuryChanged(Guid value)
    {
        _treasuryId = value;
        // الافتراضي صفر دائماً، ويبقى صفراً للخزينة النقدية — 0093.
        _commission = 0;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_form.IsValid || _treasuryId == Guid.Empty || _amount <= 0)
        {
            Snackbar.Add(T.T("validation.required_fields"), Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var actor = await UserContext.RequireAsync();
            await Treasury.CreateCashHandoverAsync(actor, new Core.Models.CashHandoverInput
            {
                BranchId = BranchId, TreasuryId = _treasuryId,
                ClearingAccountId = Guid.Empty, Amount = _amount,
                CommissionAmount = FollowInShift ? _commission : 0,
                DocDate = DateTime.Today, Notes = _notes
            });
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (AppException ex) { Snackbar.Add(T.T(ex.Code), Severity.Error); }
        finally { _busy = false; }
    }
}
