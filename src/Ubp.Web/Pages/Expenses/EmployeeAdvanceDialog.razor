@inject EmployeeAdvanceService Advances
@inject LookupService Lookup
@inject MasterDataService MasterData
@inject UserContext UserContext
@inject UiCulture T
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">صرف سلفة لموظف</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <div class="ubp-form-grid">
                <MudSelect T="Guid" @bind-Value="_employeeId" Label="الموظف" Required="true"
                           Variant="Variant.Outlined">
                    @foreach (var employee in _employees)
                    {
                        <MudSelectItem T="Guid" Value="@employee.Id">
                            @employee.Code — @employee.NameAr
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="Guid" @bind-Value="_treasuryId" Label="الخزينة" Required="true"
                           Variant="Variant.Outlined">
                    @foreach (var treasury in _treasuries)
                    {
                        <MudSelectItem T="Guid" Value="@treasury.Id">
                            @treasury.Code — @treasury.NameAr
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField @bind-Value="_amount" Label="قيمة السلفة"
                                 Variant="Variant.Outlined" Min="0.01m" Format="N2" Required="true" />
                <MudTextField @bind-Value="_notes" Label="@T.T("common.notes")"
                              Variant="Variant.Outlined" MaxLength="500" />
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">@T.T("common.cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync"
                   Disabled="@_busy">@T.T("common.save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid BranchId { get; set; }

    private MudForm _form = default!;
    private IReadOnlyList<Employee> _employees = Array.Empty<Employee>();
    private IReadOnlyList<Treasury> _treasuries = Array.Empty<Treasury>();
    private Guid _employeeId;
    private Guid _treasuryId;
    private decimal _amount;
    private string? _notes;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var actor = await UserContext.RequireAsync();
            // كل الموظفين النشطين في الفرع + كل الخزائن المكوَّدة — 0093.
            _employees = await MasterData.EmployeeBranchOptionsAsync(actor, BranchId);
            _treasuries = await Lookup.TreasuriesAsync(actor, BranchId);
            _treasuryId = _treasuries.FirstOrDefault()?.Id ?? Guid.Empty;
            _employeeId = _employees.FirstOrDefault()?.Id ?? Guid.Empty;
        }
        catch (AppException ex) { Snackbar.Add(T.T(ex.Code), Severity.Error); }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (_employeeId == Guid.Empty || _treasuryId == Guid.Empty || _amount <= 0)
        {
            Snackbar.Add(T.T("validation.required_fields"), Severity.Warning);
            return;
        }
        _busy = true;
        try
        {
            var actor = await UserContext.RequireAsync();
            var advance = await Advances.CreateAsync(actor, new EmployeeAdvanceInput
            {
                BranchId = BranchId, EmployeeId = _employeeId, TreasuryId = _treasuryId,
                ChargeAccountId = null, Amount = _amount,
                DocDate = DateTime.Today, Notes = _notes
            });
            Snackbar.Add($"تم صرف سلفة {advance.Amount:N2} للموظف {advance.EmployeeName}",
                Severity.Success);
            MudDialog.Close(DialogResult.Ok(advance));
        }
        catch (AppException ex) { Snackbar.Add(T.T(ex.Code), Severity.Error); }
        finally { _busy = false; }
    }
}
