@inject UiCulture T
<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@T.T("assets.add_reading")</MudText></TitleContent>
    <DialogContent>
        <MudNumericField T="decimal" @bind-Value="_value" Label="@T.T("assets.meter")"
                         Variant="Variant.Outlined" Min="0" />
        <MudTextField @bind-Value="_note" Label="@T.T("common.notes")" Variant="Variant.Outlined"
                      Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">@T.T("common.cancel")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">@T.T("common.save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private decimal _value;
    private string? _note;

    private void Save() => MudDialog.Close(DialogResult.Ok(_value));
}
