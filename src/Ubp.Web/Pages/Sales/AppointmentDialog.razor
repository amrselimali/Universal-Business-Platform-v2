@inherits ComponentBase

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@T.T("sales.new_appointment")</MudText></TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <div class="ubp-form-grid">
                <MudSelect T="Guid" Value="_branchId" Label="@T.T("common.branch")"
                           Variant="Variant.Outlined" ValueChanged="OnBranchChanged">
                    @foreach (var branch in Branches)
                    {
                        <MudSelectItem T="Guid" Value="@branch.Id">@branch.NameAr</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="Guid" @bind-Value="_employeeId" Label="@T.T("sales.employee")"
                           Variant="Variant.Outlined" Required="true">
                    @foreach (var employee in _employees)
                    {
                        <MudSelectItem T="Guid" Value="@employee.Id">
                            @employee.Code — @employee.NameAr
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="Guid?" @bind-Value="_customerId" Label="@T.T("sales.customer")"
                           Variant="Variant.Outlined" Clearable="true">
                    @foreach (var customer in _customers)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)customer.Id)">
                            @customer.Code — @customer.NameAr
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudDatePicker @bind-Date="_date" Label="@T.T("common.date")"
                               Variant="Variant.Outlined" />
                <MudTimePicker @bind-Time="_start" Label="@T.T("sales.start")"
                               Variant="Variant.Outlined" />
                <MudTimePicker @bind-Time="_end" Label="@T.T("sales.end")"
                               Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_notes" Label="@T.T("common.notes")"
                              Variant="Variant.Outlined" MaxLength="500" />
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@T.T("common.cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync"
                   Disabled="_busy">@T.T("common.save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public IReadOnlyList<Branch> Branches { get; set; } = Array.Empty<Branch>();
    [Parameter] public Guid? DefaultBranchId { get; set; }
    [Parameter] public DateTime DefaultDate { get; set; } = DateTime.Today;

    [Inject] private SalesFulfillmentService Fulfillment { get; set; } = default!;
    [Inject] private MasterDataService MasterData { get; set; } = default!;
    [Inject] private PartnerService Partners { get; set; } = default!;
    [Inject] private UserContext UserContext { get; set; } = default!;
    [Inject] private UiCulture T { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudForm _form = default!;
    private Guid _branchId;
    private Guid _employeeId;
    private Guid? _customerId;
    private DateTime? _date;
    private TimeSpan? _start = new(10, 0, 0);
    private TimeSpan? _end = new(10, 30, 0);
    private string? _notes;
    private IReadOnlyList<Employee> _employees = Array.Empty<Employee>();
    private IReadOnlyList<Partner> _customers = Array.Empty<Partner>();
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _branchId = DefaultBranchId ?? Branches.FirstOrDefault()?.Id ?? Guid.Empty;
        _date = DefaultDate;

        var actor = await UserContext.GetAsync();
        if (actor is null) return;
        _employees = await MasterData.EmployeeOptionsAsync(actor);
        _employeeId = _employees.FirstOrDefault()?.Id ?? Guid.Empty;
        var customers = await Partners.ListAsync(actor, PartnerKind.Customer,
            new PageRequest { Page = 1, PageSize = 25 }, null);
        _customers = customers.Items;
    }

    private void OnBranchChanged(Guid value) => _branchId = value;

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_form.IsValid || _employeeId == Guid.Empty || _date is null ||
            _start is null || _end is null)
        {
            Snackbar.Add(T.T("validation.required_fields"), Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var actor = await UserContext.RequireAsync();
            var starts = new DateTimeOffset(_date.Value.Date + _start.Value);
            var ends = new DateTimeOffset(_date.Value.Date + _end.Value);
            var appointment = await Fulfillment.CreateAppointmentAsync(actor, new AppointmentInput
            {
                BranchId = _branchId, EmployeeId = _employeeId, CustomerId = _customerId,
                StartsAt = starts, EndsAt = ends, Notes = _notes
            });
            MudDialog.Close(DialogResult.Ok(appointment));
        }
        catch (AppException ex) { Snackbar.Add(T.T(ex.Code), Severity.Error); }
        finally { _busy = false; }
    }
}
