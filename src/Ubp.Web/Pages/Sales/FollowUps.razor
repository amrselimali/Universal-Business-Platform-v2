@page "/sales/follow-ups"
@attribute [Authorize]
@inherits SecurePageBase
<PageTitle>@T.T("screen.follow_ups")</PageTitle>

@if (Denied) { <ForbiddenView /> }
else if (Loading) { <div class="ubp-loading"><MudProgressCircular Indeterminate="true" /></div> }
else
{
    <PageHeader Title="@T.T("screen.follow_ups")" Subtitle="@T.T("sales.followups_hint")">
        <Actions>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PersonSearch"
                       OnClick="FindIdleAsync" Disabled="_busy">
                @T.T("sales.idle_open")
            </MudButton>
        </Actions>
    </PageHeader>

    <MudPaper Elevation="0" Class="ubp-card mb-4">
        <div class="ubp-form-grid">
            <MudSelect T="Guid" @bind-Value="_input.CustomerId" Label="@T.T("sales.customer")"
                       Variant="Variant.Outlined">
                @foreach (var customer in _customers)
                {
                    <MudSelectItem T="Guid" Value="@customer.Id">@customer.NameAr</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" @bind-Value="_input.Channel" Label="@T.T("sales.channel")"
                       Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@FollowUpChannels.Call">@T.T("sales.channel_call")</MudSelectItem>
                <MudSelectItem T="string" Value="@FollowUpChannels.WhatsApp">WhatsApp</MudSelectItem>
                <MudSelectItem T="string" Value="@FollowUpChannels.Sms">SMS</MudSelectItem>
                <MudSelectItem T="string" Value="@FollowUpChannels.Visit">@T.T("sales.channel_visit")</MudSelectItem>
            </MudSelect>
            <MudDatePicker @bind-Date="_dueDate" Label="@T.T("sales.followup_due")"
                           Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_input.Note" Label="@T.T("common.notes")"
                          Variant="Variant.Outlined" MaxLength="500" />
        </div>
        <div class="ubp-toolbar mt-2">
            @if (Can(ActionCodes.Create))
            {
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddAsync"
                           Disabled="_busy">@T.T("common.add")</MudButton>
            }
        </div>
    </MudPaper>

    <MudPaper Elevation="0" Class="ubp-card">
        <div class="ubp-toolbar">
            <MudTextField @bind-Value="_customerSearch" Label="@T.T("sales.followup_customer_filter")"
                          Placeholder="@T.T("sales.customer_search_hint")" Immediate="true"
                          DebounceInterval="350" OnDebounceIntervalElapsed="ReloadAsync"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="ubp-search"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            <MudDatePicker @bind-Date="_from" Label="@T.T("sales.followup_due_from")"
                           Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd"
                           Editable="true" />
            <MudDatePicker @bind-Date="_to" Label="@T.T("sales.followup_due_to")"
                           Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd"
                           Editable="true" />
            <MudSelect T="string?" Value="_status" Label="@T.T("common.status")"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                       ValueChanged="OnStatusChanged">
                <MudSelectItem T="string?" Value="@FollowUpStatuses.Pending">@T.T("sales.followup_pending")</MudSelectItem>
                <MudSelectItem T="string?" Value="@FollowUpStatuses.Done">@T.T("sales.followup_done")</MudSelectItem>
                <MudSelectItem T="string?" Value="@FollowUpStatuses.Cancelled">@T.T("sales.followup_cancelled")</MudSelectItem>
            </MudSelect>
            <MudButton Variant="Variant.Text" OnClick="ReloadAsync">@T.T("common.refresh")</MudButton>
        </div>

        <MudTable Items="_items" Dense="true" Hover="true" Striped="true" Elevation="0"
                  RowsPerPage="25" Class="ubp-table">
            <HeaderContent>
                <MudTh>@T.T("sales.customer")</MudTh>
                <MudTh>@T.T("sales.booking_no")</MudTh>
                <MudTh>@T.T("sales.channel")</MudTh>
                <MudTh>@T.T("sales.followup_due")</MudTh>
                <MudTh>@T.T("common.notes")</MudTh>
                <MudTh>@T.T("common.status")</MudTh>
                <MudTh Align="Right">@T.T("common.actions")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.CustomerName</MudTd>
                <MudTd>@(context.BookingNo ?? "—")</MudTd>
                <MudTd>@T.T("sales.channel_" + context.Channel)</MudTd>
                <MudTd>@Fmt.DateTime(context.DueAt)</MudTd>
                <MudTd>@(string.IsNullOrWhiteSpace(context.Note) ? "—" : context.Note)</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(context.IsPending ? (context.IsOverdue ? Color.Error : Color.Warning) : Color.Success)">
                        @T.T("sales.followup_" + context.Status)
                    </MudChip>
                </MudTd>
                <MudTd Align="Right">
                    @if (context.IsPending && Can(ActionCodes.Complete))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                   OnClick="@(() => CompleteAsync(context))">@T.T("sales.followup_complete")</MudButton>
                    }
                    @if (Can(ActionCodes.Create))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                   Disabled="_busy" OnClick="@(() => BookAsync(context))">
                            @T.T("sales.followup_book")
                        </MudButton>
                    }
                    @if (Can(ActionCodes.Create))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                                   Disabled="_busy" OnClick="@(() => AddFollowUpAsync(context))">
                            @T.T("sales.followup_add")
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="ubp-muted pa-4">@T.T("common.no_records")</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 25 }" RowsPerPageString="@T.T("common.rows_per_page")" />
            </PagerContent>
        </MudTable>
    </MudPaper>
}
