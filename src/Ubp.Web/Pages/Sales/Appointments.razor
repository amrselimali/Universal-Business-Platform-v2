@page "/sales/appointments"
@attribute [Authorize]
@inherits SecurePageBase
@inject SalesFulfillmentService Fulfillment
@inject BranchService Branches
@inject IDialogService Dialogs
@inject IDisplayFormatter Fmt
@inject IJSRuntime JS
<PageTitle>@T.T("screen.sales_appointments")</PageTitle>

@if (Denied) { <ForbiddenView /> }
else if (Loading) { <div class="ubp-loading"><MudProgressCircular Indeterminate="true" /></div> }
else
{
    <PageHeader Title="@T.T("screen.sales_appointments")" Subtitle="@T.T("sales.appointments_hint")">
        <Actions>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.PictureAsPdf"
                       OnClick="ExportPdfAsync">@T.T("treasury.export_pdf")</MudButton>
            @if (Can(ActionCodes.Manage))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">@T.T("common.add")</MudButton>
            }
        </Actions>
    </PageHeader>

    <MudPaper Elevation="0" Class="ubp-card">
        <div class="ubp-toolbar">
            <MudDatePicker Date="_date" Label="@T.T("common.date")"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           DateChanged="OnDateChanged" />
            <MudSelect ToStringFunc="@BranchLabel" T="Guid?" Value="_branchId" Label="@T.T("common.branch")"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       ValueChanged="OnBranchChanged">
                @foreach (var branch in _branches)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)branch.Id)">@branch.NameAr</MudSelectItem>
                }
            </MudSelect>
        </div>

        <MudTable Items="_items" Dense="true" Hover="true" Striped="true" Elevation="0"
                  RowsPerPage="25" Class="ubp-table">
            <HeaderContent>
                <MudTh>@T.T("common.date")</MudTh>
                <MudTh>@T.T("sales.start")</MudTh>
                <MudTh>@T.T("sales.end")</MudTh>
                <MudTh>@T.T("sales.employee")</MudTh>
                <MudTh>@T.T("common.notes")</MudTh>
                <MudTh>@T.T("common.status")</MudTh>
                <MudTh Align="Right">@T.T("common.actions")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@Fmt.DateOnly(DateOnly.FromDateTime(Fmt.ToUserTime(context.StartsAt).Date))</MudTd>
                <MudTd>@Fmt.Time(context.StartsAt)</MudTd>
                <MudTd>@Fmt.Time(context.EndsAt)</MudTd>
                <MudTd>@context.EmployeeName</MudTd>
                <MudTd>@(string.IsNullOrWhiteSpace(context.Notes) ? "—" : context.Notes)</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(context.IsCancelled ? Color.Error : Color.Info)">
                        @T.T("sales.appointment_" + context.Status)
                    </MudChip>
                </MudTd>
                <MudTd Align="Right">
                    @if (!context.IsCancelled && Can(ActionCodes.Manage))
                    {
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true"
                                 AnchorOrigin="Origin.BottomRight">
                            <MudMenuItem OnClick="@(() => SetStatusAsync(context, AppointmentStatuses.Confirmed))">
                                @T.T("sales.appointment_confirm")
                            </MudMenuItem>
                            <MudMenuItem OnClick="@(() => SetStatusAsync(context, AppointmentStatuses.Done))">
                                @T.T("sales.appointment_done")
                            </MudMenuItem>
                            <MudMenuItem OnClick="@(() => SetStatusAsync(context, AppointmentStatuses.Cancelled))">
                                @T.T("sales.appointment_cancel")
                            </MudMenuItem>
                        </MudMenu>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private IReadOnlyList<Appointment> _items = Array.Empty<Appointment>();
    private IReadOnlyList<Branch> _branches = Array.Empty<Branch>();
    private DateTime? _date = DateTime.Today;
    private Guid? _branchId;

    protected override string ScreenCode => ScreenCodes.SalesAppointments;

    protected override async Task OnLoadAsync()
    {
        _branches = await Branches.OptionsAsync(Actor!);
        // الافتراضي فرع محدد (فرع المستخدم الحالي أو أول فرع مربوط) — لا فراغ.
        _branchId = Actor!.CurrentBranchId
                    ?? (Actor.AllowedBranchIds.Count > 0 ? Actor.AllowedBranchIds.First() : (Guid?)null)
                    ?? _branches.FirstOrDefault()?.Id;
        await ReloadAsync();
    }

    private async Task ReloadAsync() =>
        _items = await Fulfillment.ListAppointmentsAsync(Actor!, _branchId,
            _date ?? DateTime.Today);

    private Task OnDateChanged(DateTime? value) { _date = value; return RunAsync(ReloadAsync); }
    private Task OnBranchChanged(Guid? value) { _branchId = value; return RunAsync(ReloadAsync); }

    private async Task AddAsync()
    {
        var dialog = await Dialogs.ShowAsync<AppointmentDialog>(T.T("sales.new_appointment"),
            new DialogParameters
            {
                ["Branches"] = _branches, ["DefaultBranchId"] = _branchId,
                ["DefaultDate"] = _date ?? DateTime.Today
            });
        if ((await dialog.Result) is { Canceled: false })
        {
            await RunAsync(ReloadAsync);
            ShowSuccess("common.saved");
        }
    }

    private async Task SetStatusAsync(Appointment appointment, string status) =>
        await RunAsync(async () =>
        {
            await Fulfillment.SetAppointmentStatusAsync(Actor!, appointment.Id,
                appointment.Version, status);
            await ReloadAsync();
            ShowSuccess("common.saved");
        });

    /// <summary>تصدير المعروض بعد الفلاتر إلى PDF (صفحة طباعة مستقلة بالطول) — 0095.</summary>
    private async Task ExportPdfAsync()
    {
        var date = (_date ?? DateTime.Today).ToString("yyyy-MM-dd");
        var url = $"/sales/appointments/print?date={date}" +
                  (_branchId is { } branch ? $"&branch={branch}" : "");
        await JS.InvokeVoidAsync("ubpOpenPrint", url);
    }

    private string BranchLabel(Guid? id) =>
        id is null ? "—" : _branches.FirstOrDefault(b => b.Id == id)?.NameAr ?? "—";
}
