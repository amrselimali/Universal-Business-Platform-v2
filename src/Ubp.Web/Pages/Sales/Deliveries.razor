@page "/sales/deliveries"
@attribute [Authorize]
@inherits SecurePageBase
@inject SalesFulfillmentService Fulfillment
@inject BranchService Branches
@inject IDialogService Dialogs
<PageTitle>@T.T("screen.sales_deliveries")</PageTitle>

@if (Denied) { <ForbiddenView /> }
else if (Loading) { <div class="ubp-loading"><MudProgressCircular Indeterminate="true" /></div> }
else
{
    <PageHeader Title="@T.T("screen.sales_deliveries")" Subtitle="@T.T("sales.deliveries_hint")">
        <Actions>
            @if (Can(ActionCodes.Execute))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">@T.T("common.add")</MudButton>
            }
        </Actions>
    </PageHeader>

    <MudPaper Elevation="0" Class="ubp-card">
        <div class="ubp-toolbar">
            <MudSelect T="Guid?" Value="_branchId" Label="@T.T("common.branch")"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                       ValueChanged="OnBranchChanged">
                @foreach (var branch in _branches)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)branch.Id)">@branch.NameAr</MudSelectItem>
                }
            </MudSelect>
        </div>

        <MudTable Items="_items" Dense="true" Hover="true" Striped="true" Elevation="0"
                  RowsPerPage="25" Class="ubp-table">
            <HeaderContent>
                <MudTh>@T.T("sales.delivery_no")</MudTh>
                <MudTh>@T.T("common.date")</MudTh>
                <MudTh>@T.T("sales.booking_no")</MudTh>
                <MudTh>@T.T("sales.warehouse")</MudTh>
                <MudTh Align="Right">@T.T("sales.cost")</MudTh>
                <MudTh>@T.T("common.status")</MudTh>
                <MudTh Align="Right">@T.T("common.actions")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><span class="ubp-code">@(context.DocNo ?? "—")</span></MudTd>
                <MudTd>@context.DocDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd>@context.BookingNo</MudTd>
                <MudTd>@context.WarehouseName</MudTd>
                <MudTd Align="Right">@context.CostTotal.ToString("N2")</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(context.Status == DeliveryStatuses.Posted ? Color.Success : Color.Warning)">
                        @T.T("sales.delivery_status_" + context.Status)
                    </MudChip>
                </MudTd>
                <MudTd Align="Right">
                    @if (context.IsDraft && Can(ActionCodes.Post))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                   OnClick="@(() => PostAsync(context))">@T.T("accounting.post")</MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private IReadOnlyList<DeliveryNote> _items = Array.Empty<DeliveryNote>();
    private IReadOnlyList<Branch> _branches = Array.Empty<Branch>();
    private Guid? _branchId;

    protected override string ScreenCode => ScreenCodes.SalesDeliveries;

    protected override async Task OnLoadAsync()
    {
        _branches = await Branches.OptionsAsync(Actor!);
        await ReloadAsync();
    }

    private async Task ReloadAsync() =>
        _items = await Fulfillment.ListDeliveriesAsync(Actor!, _branchId, null, 200);

    private Task OnBranchChanged(Guid? value) { _branchId = value; return RunAsync(ReloadAsync); }

    private async Task AddAsync()
    {
        var dialog = await Dialogs.ShowAsync<DeliveryDialog>(T.T("sales.new_delivery"),
            new DialogParameters { ["Branches"] = _branches, ["DefaultBranchId"] = _branchId });
        if ((await dialog.Result) is { Canceled: false })
        {
            await RunAsync(ReloadAsync);
            ShowSuccess("common.saved");
        }
    }

    private async Task PostAsync(DeliveryNote note) => await RunAsync(async () =>
    {
        await Fulfillment.PostDeliveryAsync(Actor!, note.Id);
        await ReloadAsync();
        ShowSuccess("accounting.posted");
    });
}
