@page "/sales/bookings"
@attribute [Authorize]
@inherits SecurePageBase
@inject BookingService BookingApi
@inject BranchService Branches
@inject IDialogService Dialogs
@inject IDisplayFormatter Fmt
<PageTitle>@T.T("screen.sales_bookings")</PageTitle>

@if (Denied) { <ForbiddenView /> }
else if (Loading) { <div class="ubp-loading"><MudProgressCircular Indeterminate="true" /></div> }
else
{
    <PageHeader Title="@T.T("screen.sales_bookings")" Subtitle="@T.T("sales.bookings_hint")">
        <Actions>
            @if (Can(ActionCodes.Create))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">@T.T("common.add")</MudButton>
            }
        </Actions>
    </PageHeader>

    <MudPaper Elevation="0" Class="ubp-card">
        <div class="ubp-toolbar">
            <MudSelect T="Guid" SelectedValues="_branchIds" MultiSelection="true"
                       Label="@T.T("common.branch")" Variant="Variant.Outlined"
                       Margin="Margin.Dense" SelectAll="true" SelectAllText="@T.T("common.select_all")"
                       SelectedValuesChanged="OnBranchesChanged">
                @foreach (var branch in _branches)
                {
                    <MudSelectItem T="Guid" Value="@branch.Id">@branch.NameAr</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_search" Label="@T.T("sales.customer_search")"
                          Placeholder="@T.T("sales.customer_search_hint")" Immediate="true"
                          DebounceInterval="400" OnDebounceIntervalElapsed="OnSearchAsync"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            <MudDatePicker Date="_from" Label="@T.T("common.from_date")"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           DateChanged="OnFromChanged" />
            <MudDatePicker Date="_to" Label="@T.T("common.to_date")"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           DateChanged="OnToChanged" />
            <MudSelect T="string" SelectedValues="_statuses" MultiSelection="true"
                       Label="@T.T("common.status")" Variant="Variant.Outlined"
                       Margin="Margin.Dense" SelectAll="false" SelectAllText="@T.T("common.select_all")"
                       SelectedValuesChanged="OnStatusesChanged">
                <MudSelectItem T="string" Value="@BookingStatuses.Draft">@T.T("sales.status_draft")</MudSelectItem>
                <MudSelectItem T="string" Value="@BookingStatuses.Confirmed">@T.T("sales.status_confirmed")</MudSelectItem>
                <MudSelectItem T="string" Value="@BookingStatuses.Cancelled">@T.T("sales.status_cancelled")</MudSelectItem>
            </MudSelect>
        </div>

        <MudTable @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true"
                  Elevation="0" RowsPerPage="25" Class="ubp-table">
            <HeaderContent>
                <MudTh>@T.T("sales.customer")</MudTh>
                <MudTh>@T.T("sales.booking_no")</MudTh>
                <MudTh>@T.T("sales.booking_date")</MudTh>
                <MudTh>@T.T("sales.appointment_time")</MudTh>
                <MudTh>@T.T("sales.reserved_service")</MudTh>
                <MudTh>@T.T("common.notes")</MudTh>
                <MudTh>@T.T("sales.booking_created_by")</MudTh>
                <MudTh>@T.T("sales.assigned_employee")</MudTh>
                <MudTh>@T.T("common.status")</MudTh>
                <MudTh Align="Right">@T.T("common.actions")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.CustomerName</MudTd>
                <MudTd><span class="ubp-code">@(context.DocNo ?? "—")</span></MudTd>
                <MudTd>@context.BookingDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd>
                    @if (context.StartsAt is not null && context.EndsAt is not null)
                    {
                        <span dir="ltr">
                            @Fmt.Time(context.StartsAt) – @Fmt.Time(context.EndsAt)
                        </span>
                    }
                    else { <text>—</text> }
                </MudTd>
                <MudTd>@(string.IsNullOrWhiteSpace(context.ItemsSummary) ? "—" : context.ItemsSummary)</MudTd>
                <MudTd>@(string.IsNullOrWhiteSpace(context.Notes) ? "—" : context.Notes)</MudTd>
                <MudTd>@(context.CreatedByName ?? "—")</MudTd>
                <MudTd>@(context.EmployeeName ?? "—")</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@StatusColor(context.Status)">
                        @T.T("sales.status_" + StatusKey(context.Status))
                    </MudChip>
                </MudTd>
                <MudTd Align="Right">
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true"
                             AnchorOrigin="Origin.BottomRight">
                        @if (context.IsDraft && Can(ActionCodes.Edit))
                        {
                            <MudMenuItem OnClick="@(() => EditAsync(context))"
                                         Icon="@Icons.Material.Filled.Edit">@T.T("common.edit")</MudMenuItem>
                        }
                        @if (context.IsDraft && Can(ActionCodes.Confirm))
                        {
                            <MudMenuItem OnClick="@(() => ConfirmAsync(context))"
                                         Icon="@Icons.Material.Filled.CheckCircle">@T.T("sales.confirm")</MudMenuItem>
                        }
                        @if (!context.IsClosed && Can(ActionCodes.AssignOthers))
                        {
                            <MudMenuItem OnClick="@(() => AssignAsync(context))"
                                         Icon="@Icons.Material.Filled.PersonAdd">@T.T("sales.assign_responsible")</MudMenuItem>
                        }
                        @if (!context.IsClosed && Can(ActionCodes.CancelEntry))
                        {
                            <MudMenuItem OnClick="@(() => CancelAsync(context))"
                                         Icon="@Icons.Material.Filled.Block">@T.T("sales.cancel_booking")</MudMenuItem>
                        }
                    </MudMenu>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 25 }" RowsPerPageString="@T.T("common.rows_per_page")" />
            </PagerContent>
        </MudTable>
    </MudPaper>
}

@code {
    private MudTable<Booking> _table = default!;
    private IReadOnlyList<Branch> _branches = Array.Empty<Branch>();
    private HashSet<Guid> _branchIds = new();
    private string? _search;
    // فلتر الحالة: 3 خيارات فقط (مسودة/مؤكد/ملغى) والافتراضي مسودة + مؤكد.
    private HashSet<string> _statuses = new()
    {
        BookingStatuses.Draft, BookingStatuses.Confirmed
    };
    // شاشة الحجوزات = مواعيد عملاء فقط؛ لا مصدر لنقطة البيع ولا فلتر مصدر.
    private const string ScreenSource = BookingSources.Manual;
    private DateTime? _from = DateTime.Today;
    private DateTime? _to = DateTime.Today;

    protected override string ScreenCode => ScreenCodes.SalesBookings;

    protected override async Task OnLoadAsync()
    {
        _branches = await Branches.OptionsAsync(Actor!);
        // الافتراضي = كل فروع المستخدم (حد أدنى فرع واحد كما يفرضه الخادم).
        _branchIds = _branches.Select(b => b.Id).ToHashSet();
    }

    private async Task<TableData<Booking>> LoadServerData(TableState state, CancellationToken ct)
    {
        var result = await BookingApi.ListAsync(Actor!, new BookingFilter
        {
            BranchIds = _branchIds.ToList(), Statuses = _statuses.ToList(), Source = ScreenSource,
            Search = _search, From = _from, To = _to
        }, new PageRequest { Page = state.Page + 1, PageSize = 25 }, ct);
        return new TableData<Booking> { Items = result.Items, TotalItems = result.Total };
    }

    private Task OnBranchesChanged(IEnumerable<Guid> values)
    {
        _branchIds = values.ToHashSet();
        // حد أدنى فرع واحد: إن أُلغيت كلها نُعيد كل فروع المستخدم (لا صفحة بلا فلتر).
        if (_branchIds.Count == 0) _branchIds = _branches.Select(b => b.Id).ToHashSet();
        return _table.ReloadServerData();
    }
    private Task OnSearchAsync(string? value) { _search = value; return _table.ReloadServerData(); }

    private Task OnStatusesChanged(IEnumerable<string> values)
    {
        _statuses = values.ToHashSet();
        return _table.ReloadServerData();
    }

    private Task OnFromChanged(DateTime? value) { _from = value; return _table.ReloadServerData(); }
    private Task OnToChanged(DateTime? value) { _to = value; return _table.ReloadServerData(); }

    private static Color StatusColor(string status) => status switch
    {
        BookingStatuses.Completed => Color.Success,
        BookingStatuses.Cancelled => Color.Error,
        BookingStatuses.Confirmed or BookingStatuses.PartiallyDelivered => Color.Info,
        _ => Color.Warning
    };

    private static string StatusKey(string status) => status switch
    {
        BookingStatuses.Confirmed => "confirmed",
        BookingStatuses.PartiallyDelivered => "partial",
        BookingStatuses.Completed => "completed",
        BookingStatuses.Cancelled => "cancelled",
        _ => "draft"
    };

    private async Task AddAsync()
    {
        var dialog = await Dialogs.ShowAsync<BookingDialog>(T.T("sales.new_booking"),
            new DialogParameters { ["Branches"] = _branches,
                ["DefaultBranchId"] = (_branchIds.Count == 1 ? _branchIds.First() : (Guid?)null) });
        if ((await dialog.Result) is { Canceled: false })
        {
            await _table.ReloadServerData();
            ShowSuccess("common.saved");
        }
    }

    private async Task ConfirmAsync(Booking booking) => await RunAsync(async () =>
    {
        await BookingApi.ConfirmAsync(Actor!, booking.Id);
        await _table.ReloadServerData();
        ShowSuccess("sales.confirmed");
    });

    /// <summary>تعديل حجز مسودة: التاريخ/الوقت/الخدمة/الموظف/الملاحظات.</summary>
    private async Task EditAsync(Booking booking)
    {
        var dialog = await Dialogs.ShowAsync<BookingDialog>("تعديل الحجز",
            new DialogParameters { ["Branches"] = _branches, ["Model"] = booking });
        if ((await dialog.Result) is { Canceled: false })
        {
            await _table.ReloadServerData();
            ShowSuccess("common.saved");
        }
    }

    private async Task AssignAsync(Booking booking)
    {
        var dialog = await Dialogs.ShowAsync<AssignBookingDialog>(T.T("sales.assign_responsible"),
            new DialogParameters { ["Booking"] = booking });
        if ((await dialog.Result) is { Canceled: false })
        {
            await _table.ReloadServerData();
            ShowSuccess("common.saved");
        }
    }

    private async Task CancelAsync(Booking booking)
    {
        var dialog = await Dialogs.ShowAsync<CancelBookingDialog>(T.T("sales.cancel_booking"),
            new DialogParameters { ["Booking"] = booking });
        if ((await dialog.Result) is { Canceled: false })
        {
            await _table.ReloadServerData();
            ShowSuccess("common.deleted");
        }
    }
}
