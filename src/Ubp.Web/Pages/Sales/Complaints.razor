@page "/sales/complaints"
@attribute [Authorize]
@inherits SecurePageBase
<PageTitle>@T.T("screen.complaints")</PageTitle>

@if (Denied) { <ForbiddenView /> }
else if (Loading) { <div class="ubp-loading"><MudProgressCircular Indeterminate="true" /></div> }
else
{
    <PageHeader Title="@T.T("screen.complaints")" Subtitle="تسجيل شكاوى العملاء ومتابعتها" />

    <MudPaper Elevation="0" Class="ubp-card mb-4">
        <div class="ubp-form-grid">
            <MudSelect T="Guid?" @bind-Value="_input.CustomerId" Label="العميل"
                       Variant="Variant.Outlined" Clearable="true">
                @foreach (var customer in _customers)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)customer.Id)">@customer.NameAr</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="Guid?" @bind-Value="_input.EmployeeId" Label="الموظف المتسبب"
                       Variant="Variant.Outlined" Clearable="true">
                @foreach (var employee in _employees)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)employee.Id)">@employee.NameAr</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="Guid?" @bind-Value="_input.ItemId" Label="الخدمة/الصنف محل الشكوى"
                       Variant="Variant.Outlined" Clearable="true">
                @foreach (var service in _services)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)service.Id)">@service.NameAr</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_input.Description" Label="وصف الشكوى"
                          Variant="Variant.Outlined" MaxLength="1000" />
            <MudDatePicker @bind-Date="_date" Label="التاريخ" Variant="Variant.Outlined"
                           DateFormat="yyyy-MM-dd" Editable="true" />
        </div>
        <div class="ubp-toolbar mt-2">
            @if (Can(ActionCodes.Create))
            {
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddAsync"
                           Disabled="_busy">@T.T("common.add")</MudButton>
            }
        </div>
    </MudPaper>

    <MudPaper Elevation="0" Class="ubp-card">
        <div class="d-flex flex-wrap gap-2 mb-3">
            <MudDatePicker @bind-Date="_from" Label="من" Variant="Variant.Outlined"
                           DateFormat="yyyy-MM-dd" Editable="true" />
            <MudDatePicker @bind-Date="_to" Label="إلى" Variant="Variant.Outlined"
                           DateFormat="yyyy-MM-dd" Editable="true" />
            <MudSelect T="string?" Value="_status" Label="الحالة" Variant="Variant.Outlined"
                       Clearable="true" ValueChanged="OnStatusChanged">
                <MudSelectItem T="string?" Value="@ComplaintStatuses.Open">مفتوحة</MudSelectItem>
                <MudSelectItem T="string?" Value="@ComplaintStatuses.Closed">مغلقة</MudSelectItem>
            </MudSelect>
            <MudButton Variant="Variant.Text" OnClick="ReloadAsync">@T.T("common.refresh")</MudButton>
        </div>

        <MudTable Items="_items" Dense="true" Hover="true" Elevation="0" Class="ubp-table">
            <HeaderContent>
                <MudTh>التاريخ</MudTh>
                <MudTh>العميل</MudTh>
                <MudTh>الموظف المتسبب</MudTh>
                <MudTh>الخدمة</MudTh>
                <MudTh>الوصف</MudTh>
                <MudTh>الحالة</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@Fmt.Date(context.DocDate)</MudTd>
                <MudTd>@context.CustomerName</MudTd>
                <MudTd>@context.EmployeeName</MudTd>
                <MudTd>@context.ItemName</MudTd>
                <MudTd>@context.Description</MudTd>
                <MudTd>@(context.IsOpen ? "مفتوحة" : "مغلقة")</MudTd>
                <MudTd>
                    @if (context.IsOpen && Can(ActionCodes.Edit))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                                   OnClick="@(() => CloseAsync(context))" Disabled="_busy">إغلاق</MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}