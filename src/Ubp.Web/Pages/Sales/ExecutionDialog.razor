@inherits ComponentBase
@inject BookingExecutionService Executions
@inject MasterDataService MasterData
@inject UserContext UserContext
@inject UiCulture T
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@T.T("execution.title")</MudText></TitleContent>
    <DialogContent>
        @if (_preview is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <div class="ubp-form-grid">
                <MudTextField Value="_preview.CustomerName" Label="@T.T("sales.customer")"
                              Variant="Variant.Outlined" ReadOnly="true" />
                <MudTextField Value="@(_preview.ItemCode + " — " + _preview.ItemName)"
                              Label="@T.T("execution.service")" Variant="Variant.Outlined"
                              ReadOnly="true" />
                <MudSelect T="Guid?" @bind-Value="_executorId" Clearable="true"
                           Label="الموظف المنفذ (من زر التنفيذ)" Variant="Variant.Outlined">
                    @foreach (var employee in _employees)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)employee.Id)">
                            @employee.NameAr
                        </MudSelectItem>
                    }
                </MudSelect>
                @if (ItemExecutionModes.IsDirect(_preview.ExecutionMode))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                             Variant="Variant.Outlined">
                        @T.T("execution.direct")
                    </MudChip>
                }
                <MudTextField Value="@_preview.RemainingQty.ToString("N2")"
                              Label="@T.T("execution.remaining")" Variant="Variant.Outlined"
                              ReadOnly="true" />
                <MudNumericField T="decimal" @bind-Value="_quantity" Label="@T.T("execution.quantity")"
                                 Variant="Variant.Outlined" Min="0.0001m"
                                 Max="@_preview.RemainingQty" Format="N2" />
                @if (_preview.ItemIsMetered)
                {
                    @if (_preview.MeterAssets.Count > 0)
                    {
                        <MudSelect T="Guid?" @bind-Value="_meterAssetId" Clearable="true"
                                   Required="true"
                                   Label="@T.T("execution.meter_asset")"
                                   Variant="Variant.Outlined">
                            @foreach (var asset in _preview.MeterAssets)
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)asset.Id)">
                                    @asset.Code — @asset.NameAr (@asset.MeterType)
                                </MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="ubp-span-2">
                            @T.T("execution.no_meter_assets")
                        </MudAlert>
                    }
                    @if (_meterAssetId is not null)
                    {
                        <MudNumericField T="decimal" @bind-Value="_meterUnits"
                                         Label="@_preview.UnitsColumnLabel"
                                         Variant="Variant.Outlined" Min="0.0001m" Format="N2" />
                        @if (_meterUnits <= 0)
                        {
                            <MudText Typo="Typo.caption" Class="ubp-muted ubp-span-2">
                                @T.T("validation.meter_units_required")
                            </MudText>
                        }
                        @if (SelectedAsset is not null)
                        {
                            <MudText Typo="Typo.caption" Class="ubp-muted ubp-span-2">
                                @T.T("execution.current_meter"):
                                @SelectedAsset.CurrentMeterValue.ToString("N2")
                                @SelectedAsset.MeterType
                            </MudText>
                        }
                    }
                    <MudText Typo="Typo.caption" Class="ubp-muted ubp-span-2">
                        @T.T("execution.meter_required")
                    </MudText>
                }
                @if (_preview.RemainingQty <= 0)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="ubp-span-2">
                        @T.T("execution.no_remaining")
                    </MudAlert>
                }
                @if (_preview.ItemType == "SERVICE" &&
                     !ItemExecutionModes.IsDirect(_preview.ExecutionMode) &&
                     _executorId is null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="ubp-span-2">
                        @T.T("validation.execution_employee_required")
                    </MudAlert>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">@T.T("common.cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync"
                   Disabled="@(_busy || _preview is null || _preview.RemainingQty <= 0 ||
                               _quantity <= 0 ||
                               (!ItemExecutionModes.IsDirect(_preview.ExecutionMode) &&
                                _preview.ItemType == "SERVICE" &&
                                _executorId is null) ||
                               (!ItemExecutionModes.IsDirect(_preview.ExecutionMode) &&
                                _preview.ItemIsMetered &&
                                (_meterAssetId is null || _meterUnits <= 0)))">@T.T("execution.confirm")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid BookingLineId { get; set; }

    private BookingExecutionPreview? _preview;
    private IReadOnlyList<Employee> _employees = Array.Empty<Employee>();
    private Guid? _executorId;
    private decimal _quantity;
    private Guid? _meterAssetId;
    private decimal _meterUnits;
    private bool _busy;

    private ExecutionMeterAsset? SelectedAsset =>
        _preview?.MeterAssets.FirstOrDefault(a => a.Id == _meterAssetId);

    protected override async Task OnInitializedAsync()
    {
        var actor = await UserContext.GetAsync();
        if (actor is null) return;
        try
        {
            _preview = await Executions.GetPreviewAsync(actor, BookingLineId);
            _employees = await MasterData.EmployeeOptionsAsync(actor);
        }
        catch (AppException ex)
        {
            // مثل «لا يمكن التسجيل قبل فتح وردية»: رسالة واضحة بدل انهيار الحوار.
            Snackbar.Add(T.T(ex.Code), Severity.Error);
            MudDialog.Cancel();
            return;
        }
        _quantity = _preview.RemainingQty;
        // الأصناف المرتبطة بعدّاد: الأصل والوحدات إجباريان. يُحدَّد الأصل تلقائيًا عند وجود أصل واحد فقط.
        _meterAssetId = _preview.ItemIsMetered && _preview.MeterAssets.Count == 1
            ? _preview.MeterAssets[0].Id
            : null;
        _meterUnits = 0;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_preview is null || _preview.RemainingQty <= 0) return;
        if (_quantity <= 0 || _quantity > _preview.RemainingQty) return;
        if (!ItemExecutionModes.IsDirect(_preview.ExecutionMode) && _preview.ItemIsMetered &&
            (_meterAssetId is null || _meterUnits <= 0)) return;
        _busy = true;
        try
        {
            var actor = await UserContext.RequireAsync();
            var result = await Executions.ExecuteAsync(actor, new BookingExecutionInput
            {
                BookingLineId = BookingLineId, Quantity = _quantity,
                MeteredAssetId = _preview.ItemIsMetered ? _meterAssetId : null,
                MeterUnits = _preview.ItemIsMetered ? _meterUnits : 0,
                EmployeeId = _executorId
            });
            MudDialog.Close(DialogResult.Ok(result));
        }
        catch (AppException ex) { Snackbar.Add(T.T(ex.Code), Severity.Error); }
        finally { _busy = false; }
    }
}
