@inject DatabaseAdminService DatabaseService
@inject UserContext UserContext
@inject UiCulture T
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">مسح بيانات جداول مُحددة</MudText></TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
            سيتم مسح <b>كل البيانات</b> من الجداول المحددة <b>فقط</b> (بلا حذف متسلسل) ولا يمكن
            التراجع. إن كانت جداول أخرى تشير لهذه الجداول بمفتاح أجنبي سيفشل المسح — أضف الجداول
            المرتبطة أو أزل القيود.
        </MudAlert>
        <MudTable Items="Tables" Dense="true" Hover="true" Elevation="0" Class="ubp-table"
                  Height="420px">
            <HeaderContent>
                <MudTh></MudTh>
                <MudTh>الجدول</MudTh>
                <MudTh Align="Right">عدد الصفوف</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudCheckBox T="bool" Dense="true" Value="@_selected.Contains(context.Name)"
                                 ValueChanged="@(v => Toggle(context.Name, v))" />
                </MudTd>
                <MudTd>@context.Name</MudTd>
                <MudTd Align="Right">@context.RowCount.ToString("N0")</MudTd>
            </RowTemplate>
        </MudTable>
        <MudText Typo="Typo.body2" Class="mt-2">المحدد: <b>@_selected.Count</b> جدول</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">@T.T("common.cancel")</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="ClearAsync"
                   Disabled="@(_busy || _selected.Count == 0)">مسح البيانات المحددة</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public IReadOnlyList<TableInfo> Tables { get; set; } = Array.Empty<TableInfo>();

    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    private bool _busy;

    private void Toggle(string name, bool value)
    {
        if (value) _selected.Add(name);
        else _selected.Remove(name);
        StateHasChanged();
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task ClearAsync()
    {
        _busy = true;
        try
        {
            var actor = await UserContext.RequireAsync();
            var cleared = await DatabaseService.ClearTablesAsync(actor, _selected.ToList());
            Snackbar.Add($"تم مسح بيانات {cleared} جدول", Severity.Success);
            MudDialog.Close(DialogResult.Ok(cleared));
        }
        catch (AppException ex) { Snackbar.Add(T.T(ex.Code), Severity.Error); }
        finally { _busy = false; }
    }
}
