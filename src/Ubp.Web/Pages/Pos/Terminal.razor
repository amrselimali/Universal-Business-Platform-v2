@page "/pos/terminal"
@attribute [Authorize]
@inherits SecurePageBase
@inject PosService Pos
@inject BranchService Branches
@inject ItemService Items
@inject WarehouseService Warehouses
@inject PartnerService Partners
@inject TreasuryService Treasury
@inject IJSRuntime JS
<PageTitle>@T.T("screen.pos_terminal")</PageTitle>

@if (Denied) { <ForbiddenView /> }
else if (Loading) { <div class="ubp-loading"><MudProgressCircular Indeterminate="true" /></div> }
else
{
    <PageHeader Title="@T.T("screen.pos_terminal")" Subtitle="@T.T("pos.terminal_hint")" />

    <MudButtonGroup Class="mb-3 ubp-print-hide">
        <MudButton Variant="@(_appointmentMode ? Variant.Outlined : Variant.Filled)"
                   Color="Color.Primary" OnClick="@(() => _appointmentMode = false)">
            @T.T("pos.mode_sale")
        </MudButton>
        <MudButton Variant="@(_appointmentMode ? Variant.Filled : Variant.Outlined)"
                   Color="Color.Primary" OnClick="@(() => _appointmentMode = true)">
            @T.T("pos.mode_appointment")
        </MudButton>
    </MudButtonGroup>

    @if (!_appointmentMode)
    {
    <MudGrid Class="ubp-print-hide" Spacing="2">
        <MudItem xs="12" md="7">
            <MudPaper Elevation="0" Class="ubp-card">
                <div class="ubp-toolbar">
                    <MudText Typo="Typo.subtitle1">@T.T("pos.products")</MudText>
                    <MudTextField @bind-Value="_search" Placeholder="@T.T("pos.search_products")"
                                  Immediate="true" DebounceInterval="300"
                                  OnDebounceIntervalElapsed="SearchAsync"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="ubp-search" />
                    <MudSelect T="Guid" Value="_branchId" Label="@T.T("common.branch")"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               ValueChanged="OnBranchChanged">
                        @foreach (var branch in _branches)
                        {
                            <MudSelectItem T="Guid" Value="@branch.Id">@branch.NameAr</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                @if (_products.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">@T.T("pos.no_products")</MudAlert>
                }
                else
                {
                    <MudGrid Spacing="1">
                        @foreach (var product in _products)
                        {
                            <MudItem xs="6" sm="4" md="3">
                                <MudPaper Outlined="true" Class="pa-2 pos-product"
                                          @onclick="@(() => AddToCart(product))">
                                    <MudText Typo="Typo.subtitle2">@product.NameAr</MudText>
                                    <MudText Typo="Typo.caption">
                                        @T.T("sales.item_type_" + product.ItemType.ToLowerInvariant())
                                        @if (product.ItemType == "GOODS")
                                        {
                                            <text> · @product.OnHand.ToString("N2")</text>
                                        }
                                    </MudText>
                                    <MudText Typo="Typo.body2">
                                        <b>@PriceOf(product).ToString("N2")</b>
                                    </MudText>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="5">
            <MudPaper Elevation="0" Class="ubp-card">
                <MudSelect T="Guid" Value="_customerId" Label="@T.T("sales.customer")"
                           Variant="Variant.Outlined" ValueChanged="OnCustomerChanged"
                           Class="mb-2">
                    @foreach (var customer in _customers)
                    {
                        <MudSelectItem T="Guid" Value="@customer.Id">
                            @customer.NameAr @(string.IsNullOrWhiteSpace(customer.Phone) ? "" : $" — {customer.Phone}")
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudTable Items="_cart" Dense="true" Elevation="0" Class="ubp-table">
                    <HeaderContent>
                        <MudTh>@T.T("sales.item")</MudTh>
                        <MudTh Align="Right">@T.T("sales.quantity")</MudTh>
                        <MudTh Align="Right">@T.T("sales.price")</MudTh>
                        <MudTh Align="Right">@T.T("accounting.total")</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            @context.Name
                            @if (context.TaxRate > 0)
                            {
                                <MudText Typo="Typo.caption">@T.T("pos.tax"): @context.TaxRate%</MudText>
                            }
                        </MudTd>
                        <MudTd Align="Right">
                            <MudNumericField T="decimal" @bind-Value="context.Quantity" Min="0.0001m"
                                             Format="N4" Dense="true" />
                        </MudTd>
                        <MudTd Align="Right">
                            <MudNumericField T="decimal" @bind-Value="context.UnitPrice" Min="0m"
                                             Format="N4" Dense="true" />
                        </MudTd>
                        <MudTd Align="Right">@context.Total.ToString("N2")</MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           OnClick="@(() => _cart.Remove(context))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <div class="pos-totals mt-2">
                    <div><span>@T.T("pos.net")</span><b>@Net.ToString("N2")</b></div>
                    <div><span>@T.T("pos.tax")</span><b>@Tax.ToString("N2")</b></div>
                    <div><span>@T.T("pos.fees")</span><b>@Fees.ToString("N2")</b></div>
                    <div class="pos-grand"><span>@T.T("accounting.total")</span><b>@Total.ToString("N2")</b></div>
                </div>

                <MudTable Items="_payments" Dense="true" Elevation="0" Class="ubp-table mt-2">
                    <HeaderContent>
                        <MudTh>@T.T("treasury.method")</MudTh>
                        <MudTh Align="Right">@T.T("common.amount")</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudSelect T="Guid" Value="context.TreasuryMethodId" Dense="true"
                                       ValueChanged="@(v => context.TreasuryMethodId = v)">
                                @foreach (var method in _methods)
                                {
                                    <MudSelectItem T="Guid" Value="@method.Id">
                                        @method.NameAr (@method.FeePercent.ToString("N2")%)
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudTd>
                        <MudTd Align="Right">
                            <MudNumericField T="decimal" @bind-Value="context.Amount" Min="0m"
                                             Format="N2" Dense="true" />
                            <MudText Typo="Typo.caption">@T.T("pos.fee"): @FeeOf(context).ToString("N2")</MudText>
                        </MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           OnClick="@(() => _payments.Remove(context))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <div class="ubp-toolbar mt-2">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddPayment">@T.T("pos.add_payment")</MudButton>
                    <MudText>@T.T("pos.paid"): <b>@Paid.ToString("N2")</b></MudText>
                    @if (Can(ActionCodes.Checkout))
                    {
                        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                                   OnClick="CheckoutAsync" Disabled="@(_busy || _cart.Count == 0)">
                            @T.T("pos.checkout")
                        </MudButton>
                    }
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
    }
    else
    {
        <MudPaper Elevation="0" Class="ubp-card ubp-print-hide">
            <MudText Typo="Typo.subtitle1" Class="mb-2">@T.T("pos.mode_appointment")</MudText>
            <div class="ubp-form-grid">
                <MudSelect T="Guid" Value="_branchId" Label="@T.T("common.branch")"
                           Variant="Variant.Outlined" ValueChanged="OnBranchChanged">
                    @foreach (var branch in _branches)
                    {
                        <MudSelectItem T="Guid" Value="@branch.Id">@branch.NameAr</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="Guid" Value="_customerId" Label="@T.T("sales.customer")"
                           Variant="Variant.Outlined" ValueChanged="OnCustomerChanged">
                    @foreach (var customer in _customers)
                    {
                        <MudSelectItem T="Guid" Value="@customer.Id">
                            @customer.NameAr @(string.IsNullOrWhiteSpace(customer.Phone) ? "" : $" — {customer.Phone}")
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="Guid" @bind-Value="_appointmentItemId" Label="@T.T("sales.item")"
                           Variant="Variant.Outlined">
                    @foreach (var service in Services)
                    {
                        <MudSelectItem T="Guid" Value="@service.Id">@service.NameAr</MudSelectItem>
                    }
                </MudSelect>
                <MudDatePicker @bind-Date="_appointmentDate" Label="@T.T("common.date")"
                               Variant="Variant.Outlined" />
                <MudTimePicker @bind-Time="_startTime" Label="@T.T("sales.from")"
                               Variant="Variant.Outlined" />
                <MudTimePicker @bind-Time="_endTime" Label="@T.T("sales.to")"
                               Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_appointmentNotes" Label="@T.T("common.notes")"
                              Variant="Variant.Outlined" MaxLength="500" />
            </div>
            <div class="ubp-toolbar mt-2">
                @if (Can(ActionCodes.Checkout))
                {
                    <MudButton Color="Color.Primary" Variant="Variant.Filled"
                               OnClick="BookAppointmentAsync" Disabled="_busy">
                        @T.T("pos.book_appointment")
                    </MudButton>
                }
                @if (_appointmentReceipt is not null)
                {
                    <MudAlert Severity="Severity.Success" Dense="true">
                        @T.T("pos.appointment_created"): @_appointmentReceipt.BookingNo
                    </MudAlert>
                }
            </div>
        </MudPaper>
    }

    @if (_receipt is not null)
    {
        <MudPaper Elevation="0" Class="ubp-card mt-4">
            <div class="ubp-toolbar">
                <MudText Typo="Typo.subtitle1">@T.T("pos.receipt")</MudText>
                <MudButton StartIcon="@Icons.Material.Filled.Print" Variant="Variant.Outlined"
                           OnClick="PrintAsync">@T.T("pos.print")</MudButton>
                @if (WhatsAppUrl is not null)
                {
                    <MudButton Href="@WhatsAppUrl" Target="_blank"
                               StartIcon="@Icons.Material.Filled.Send" Variant="Variant.Outlined"
                               Color="Color.Success">@T.T("pos.send_whatsapp")</MudButton>
                }
            </div>

            <div id="pos-print-area" class="pos-receipt">
                <div class="pos-receipt-head">
                    <div><b>@T.T("pos.receipt")</b></div>
                    <div>@_receipt.BookingNo · @DateTime.Now.ToString("yyyy-MM-dd HH:mm")</div>
                    <div>@_customerName</div>
                </div>
                <table>
                    <tbody>
                        @foreach (var line in _lastLines)
                        {
                            <tr>
                                <td>@line.Name × @line.Quantity.ToString("N2")</td>
                                <td class="num">@line.Total.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="pos-receipt-totals">
                    <div><span>@T.T("pos.net")</span><span>@_lastNet.ToString("N2")</span></div>
                    <div><span>@T.T("pos.tax")</span><span>@_receipt.TaxTotal.ToString("N2")</span></div>
                    <div><span>@T.T("pos.fees")</span><span>@_receipt.FeeTotal.ToString("N2")</span></div>
                    <div><b>@T.T("accounting.total")</b><b>@_receipt.Total.ToString("N2")</b></div>
                    <div><span>@T.T("pos.paid")</span><span>@_receipt.Paid.ToString("N2")</span></div>
                </div>
            </div>
        </MudPaper>
    }
}
