@page "/pos/receipts"
@attribute [Authorize]
@inherits SecurePageBase
@inject PosService Pos
@inject BranchService Branches
@inject IDialogService Dialogs
<PageTitle>@T.T("screen.pos_receipts")</PageTitle>

@if (Denied) { <ForbiddenView /> }
else if (Loading) { <div class="ubp-loading"><MudProgressCircular Indeterminate="true" /></div> }
else
{
    <PageHeader Title="@T.T("screen.pos_receipts")" Subtitle="@T.T("pos.receipts_hint")" />

    <MudPaper Elevation="0" Class="ubp-card">
        <div class="ubp-toolbar">
            <MudSelect T="Guid?" Value="_branchId" Label="@T.T("common.branch")"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       ToStringFunc="@BranchLabel" ValueChanged="OnBranchChanged">
                @foreach (var branch in _branches)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)branch.Id)">@branch.NameAr</MudSelectItem>
                }
            </MudSelect>
            <MudDatePicker Date="_from" Label="@T.T("common.from_date")"
                           Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd"
                           Editable="true" DateChanged="OnFromChanged" />
            <MudDatePicker Date="_to" Label="@T.T("common.to_date")"
                           Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd"
                           Editable="true" DateChanged="OnToChanged" />
        </div>

        <MudTable Items="_items" Dense="true" Hover="true" Striped="true" Elevation="0"
                  RowsPerPage="25" Class="ubp-table">
            <HeaderContent>
                <MudTh>@T.T("common.date")</MudTh>
                <MudTh>@T.T("sales.customer")</MudTh>
                <MudTh>@T.T("treasury.treasury")</MudTh>
                <MudTh>@T.T("pos.receipt_description")</MudTh>
                <MudTh Align="Right">@T.T("pos.paid_before")</MudTh>
                <MudTh Align="Right">@T.T("pos.remaining_due")</MudTh>
                <MudTh Align="Right">@T.T("accounting.total")</MudTh>
                <MudTh Align="Right">@T.T("common.actions")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.DocDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd>@context.PartyName</MudTd>
                <MudTd>@(string.IsNullOrWhiteSpace(context.TreasuryName) ? "—" : context.TreasuryName)</MudTd>
                <MudTd>
                    @(string.IsNullOrWhiteSpace(context.Services) ? "—" : context.Services)
                    @if (context.BookingDate is not null)
                    {
                        <div class="ubp-muted ubp-small">
                            @T.T("sales.booking_date"): @context.BookingDate.Value.ToString("yyyy-MM-dd")
                        </div>
                    }
                </MudTd>
                <MudTd Align="Right">
                    @(context.BookingDate is null ? "—" : context.PaidBefore.ToString("N2"))
                </MudTd>
                <MudTd Align="Right">
                    @(context.BookingDate is null ? "—" : context.Remaining.ToString("N2"))
                </MudTd>
                <MudTd Align="Right">@context.Total.ToString("N2")</MudTd>
                <MudTd Align="Right">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                   Title="@T.T("pos.view_receipt")" Color="Color.Primary"
                                   OnClick="@(() => ViewAsync(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Send" Size="Size.Small"
                                   Title="@T.T("pos.send_whatsapp")" Color="Color.Success"
                                   OnClick="@(() => SendWhatsAppAsync(context))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="ubp-muted pa-4">@T.T("common.no_records")</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 25, 50 }"
                               RowsPerPageString="@T.T("common.rows_per_page")" />
            </PagerContent>
        </MudTable>

        <MudText Typo="Typo.body2" Class="pa-4">
            @T.T("accounting.total"): <b>@_items.Sum(i => i.Total).ToString("N2")</b>
        </MudText>
    </MudPaper>
}

@code {
    private IReadOnlyList<CommercialDocument> _items = Array.Empty<CommercialDocument>();
    private IReadOnlyList<Branch> _branches = Array.Empty<Branch>();
    private Guid? _branchId;
    private DateTime? _from = DateTime.Today;
    private DateTime? _to = DateTime.Today;

    protected override string ScreenCode => ScreenCodes.PosReceipts;

    protected override async Task OnLoadAsync()
    {
        _branches = await Branches.OptionsAsync(Actor!);
        _branchId = Actor!.CurrentBranchId ?? _branches.FirstOrDefault()?.Id;
        await ReloadAsync();
    }

    private async Task ReloadAsync() =>
        _items = await Pos.ListReceiptsAsync(Actor!, _branchId, _from, _to, 500);

    private Task OnBranchChanged(Guid? value) { _branchId = value; return RunAsync(ReloadAsync); }
    private Task OnFromChanged(DateTime? value) { _from = value; return RunAsync(ReloadAsync); }
    private Task OnToChanged(DateTime? value) { _to = value; return RunAsync(ReloadAsync); }
    private string BranchLabel(Guid? id) =>
        id is null ? "—" : _branches.FirstOrDefault(b => b.Id == id)?.NameAr ?? "—";

    private async Task ViewAsync(CommercialDocument doc) =>
        await Dialogs.ShowAsync<ViewReceiptDialog>(T.T("pos.view_receipt"),
            new DialogParameters { ["VoucherId"] = doc.Id });

    private async Task SendWhatsAppAsync(CommercialDocument doc) => await RunAsync(async () =>
    {
        var sent = await Pos.SendReceiptWhatsAppAsync(Actor!, doc.Id);
        Snackbar.Add(T.T(sent ? "pos.whatsapp_queued" : "pos.whatsapp_unavailable"),
            sent ? Severity.Success : Severity.Warning);
    });
}
