@inject BookingCollectionService Collections
@inject UserContext UserContext
@inject UiCulture T
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@T.T("pos.collect_title") — @CustomerName</MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (_rows.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                @T.T("pos.no_outstanding_services")
            </MudAlert>
        }
        else
        {
            <MudTable Items="_rows" Dense="true" Hover="true" Elevation="0" Class="ubp-table">
                <HeaderContent>
                    <MudTh>@T.T("sales.booking_no")</MudTh>
                    <MudTh>@T.T("pos.services")</MudTh>
                    <MudTh Align="Right">@T.T("accounting.total")</MudTh>
                    <MudTh Align="Right">@T.T("pos.paid_previously")</MudTh>
                    <MudTh Align="Right">@T.T("pos.remaining_due")</MudTh>
                    <MudTh></MudTh>
                    <MudTh Align="Right">@T.T("pos.collect_amount")</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.BookingNo</MudTd>
                    <MudTd>@context.Services</MudTd>
                    <MudTd Align="Right">@context.TotalAmount.ToString("N2")</MudTd>
                    <MudTd Align="Right">@context.PaidAmount.ToString("N2")</MudTd>
                    <MudTd Align="Right"><b>@context.RemainingAmount.ToString("N2")</b></MudTd>
                    <MudTd>
                        <MudCheckBox T="bool" Value="@context.Selected" Dense="true"
                                     ValueChanged="@(v => Toggle(context, v))" />
                    </MudTd>
                    <MudTd Align="Right">
                        <MudNumericField T="decimal" @bind-Value="context.Amount"
                                         Min="0m" Max="@context.RemainingAmount" Format="N2"
                                         Dense="true" Disabled="@(!context.Selected)" />
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">@T.T("treasury.treasuries")</MudText>
            <MudTable Items="_payments" Dense="true" Elevation="0" Class="ubp-table">
                <HeaderContent>
                    <MudTh>@T.T("treasury.treasury")</MudTh>
                    <MudTh Align="Right">@T.T("pos.payment_total")</MudTh>
                    <MudTh Align="Right">@T.T("pos.collected_amount")</MudTh>
                    <MudTh Align="Right">@T.T("pos.fee")</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudSelect T="Guid" Value="context.TreasuryId" Dense="true"
                                   ValueChanged="@(v => PickTreasury(context, v))">
                            @foreach (var treasury in Treasuries)
                            {
                                <MudSelectItem T="Guid" Value="@treasury.Id">
                                    @treasury.Code — @treasury.NameAr
                                    (@treasury.ProviderFeePercent.ToString("N2")%)
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd Align="Right">
                        <MudNumericField T="decimal" Value="context.Total" Min="0m"
                                         ValueChanged="@(v => SetTotal(context, v))"
                                         Format="N2" Dense="true" />
                    </MudTd>
                    <MudTd Align="Right">@context.Collected.ToString("N2")</MudTd>
                    <MudTd Align="Right">@context.Fee.ToString("N2")</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       OnClick="@(() => _payments.Remove(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="mt-2"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="AddPayment">@T.T("pos.add_payment")</MudButton>

            <div class="pos-receipt mt-3">
                <div class="pos-receipt-head">
                    <div><b>@T.T("pos.receipt")</b> — @T.T("pos.preview")</div>
                    <div>@DateTime.Now.ToString("yyyy-MM-dd HH:mm")</div>
                    <div>@CustomerName</div>
                </div>
                <table>
                    <tbody>
                        @foreach (var row in _rows.Where(r => r.Selected && r.Amount > 0))
                        {
                            <tr>
                                <td>@row.BookingNo — @row.Services</td>
                                <td class="num">@row.Amount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="pos-receipt-totals">
                    <div><span>@T.T("pos.collected_amount")</span><span>@CollectedTotal.ToString("N2")</span></div>
                    <div><span>@T.T("pos.fees")</span><span>@FeeTotal.ToString("N2")</span></div>
                    <div><b>@T.T("accounting.total")</b><b>@GrandTotal.ToString("N2")</b></div>
                    <div><span>@T.T("pos.paid")</span><span>@PaidTotal.ToString("N2")</span></div>
                    <div><span>@T.T("pos.remaining_on_services")</span><span>@RemainingOnServices.ToString("N2")</span></div>
                </div>
                <div class="mt-2">
                    <MudText Typo="Typo.caption" Class="ubp-muted">@T.T("pos.partial_allowed")</MudText>
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@T.T("common.cancel")</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Outlined" OnClick="DraftAsync"
                   Disabled="@CannotSave">@T.T("pos.save_draft_only")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="CollectAsync"
                   Disabled="@CannotSave">@T.T("pos.collect_confirm")</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Outlined" OnClick="WhatsAppAsync"
                   StartIcon="@Icons.Material.Filled.Send"
                   Disabled="@CannotSave">@T.T("pos.save_and_send_whatsapp")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CompleteAsync"
                   Disabled="@CannotSave">@T.T("pos.complete")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private sealed class PayLine
    {
        public Guid TreasuryId { get; set; }
        public decimal Total { get; set; }
        public decimal Fee { get; set; }
        public decimal Collected => Math.Max(Total - Fee, 0);
    }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid BranchId { get; set; }
    [Parameter] public Guid CustomerId { get; set; }
    [Parameter] public string? CustomerName { get; set; }
    [Parameter] public IReadOnlyList<Treasury> Treasuries { get; set; } =
        Array.Empty<Treasury>();

    private List<BookingCollectionRow> _rows = new();
    private List<PayLine> _payments = new();
    private bool _loading = true;
    private bool _busy;

    private decimal SelectedTotal => Math.Round(_rows.Where(r => r.Selected)
        .Sum(r => Math.Round(r.Amount, 2, MidpointRounding.AwayFromZero)), 2,
        MidpointRounding.AwayFromZero);
    private decimal FeeTotal => Math.Round(_payments.Sum(p => p.Fee), 2,
        MidpointRounding.AwayFromZero);
    private decimal PaidTotal => Math.Round(_payments.Sum(p => p.Total), 2,
        MidpointRounding.AwayFromZero);
    private decimal CollectedTotal => Math.Round(_payments.Sum(p => p.Collected), 2,
        MidpointRounding.AwayFromZero);
    private decimal GrandTotal => Math.Round(CollectedTotal + FeeTotal, 2,
        MidpointRounding.AwayFromZero);
    private decimal RemainingOnServices => Math.Max(Math.Round(SelectedTotal - CollectedTotal, 2,
        MidpointRounding.AwayFromZero), 0);

    private async Task ReloadRowsAsync(ActorContext actor)
    {
        _rows = (await Collections.ListOutstandingAsync(actor, BranchId, CustomerId)).ToList();
        _payments.Clear();
        AddPayment();
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        var actor = await UserContext.GetAsync();
        if (actor is null) return;
        _rows = (await Collections.ListOutstandingAsync(actor, BranchId, CustomerId)).ToList();
        _loading = false;
    }

    private void Toggle(BookingCollectionRow row, bool value)
    {
        row.Selected = value;
        row.Amount = value ? row.RemainingAmount : 0m;
        if (value && _payments.Count == 0) AddPayment();
        StateHasChanged();
    }

    private decimal FeeFor(Guid treasuryId, decimal total)
    {
        var treasury = Treasuries.FirstOrDefault(t => t.Id == treasuryId);
        return treasury is null ? 0m
            : Math.Round(total * treasury.ProviderFeePercent / 100m + treasury.ProviderFeeAmount,
                2, MidpointRounding.AwayFromZero);
    }

    private void AddPayment()
    {
        var treasury = Treasuries.FirstOrDefault();
        if (treasury is null) return;
        var remaining = Math.Max(SelectedTotal - _payments.Sum(p => p.Collected), 0);
        var fee = FeeFor(treasury.Id, remaining);
        _payments.Add(new PayLine
        {
            TreasuryId = treasury.Id,
            Total = Math.Round(remaining + fee, 2, MidpointRounding.AwayFromZero), Fee = fee
        });
        StateHasChanged();
    }

    private void PickTreasury(PayLine line, Guid treasuryId)
    {
        line.TreasuryId = treasuryId;
        line.Fee = FeeFor(treasuryId, line.Total);
        StateHasChanged();
    }

    private void SetTotal(PayLine line, decimal total)
    {
        line.Total = Math.Max(total, 0);
        line.Fee = FeeFor(line.TreasuryId, line.Total);
        StateHasChanged();
    }

    private void Cancel() => MudDialog.Cancel();

    private bool CannotSave => _busy || _loading || SelectedTotal <= 0 || CollectedTotal <= 0 ||
                               CollectedTotal > SelectedTotal;

    private Task DraftAsync() => SaveAsync(draftOnly: true, closeAfter: false);
    private Task CollectAsync() => SaveAsync(draftOnly: false, closeAfter: false);
    private Task CompleteAsync() => SaveAsync(draftOnly: false, closeAfter: true);
    private Task WhatsAppAsync() => SaveAsync(draftOnly: false, closeAfter: true);

    private async Task SaveAsync(bool draftOnly = false, bool closeAfter = true)
    {
        var lines = _rows.Where(r => r.Selected && r.Amount > 0)
            .Select(r => new BookingCollectionLineInput
            { BookingId = r.BookingId, Kind = r.Kind, Amount = r.Amount })
            .ToList();
        var payments = _payments.Where(p => p.Total > 0).Select(p => new PosPaymentInput
        {
            TreasuryId = p.TreasuryId, TreasuryMethodId = Guid.Empty, Amount = p.Total
        }).ToList();
        if (lines.Count == 0 || payments.Count == 0) return;

        _busy = true;
        try
        {
            var actor = await UserContext.RequireAsync();
            var result = await Collections.CollectAsync(actor, new BookingCollectionInput
            {
                BranchId = BranchId, CustomerId = CustomerId, DocDate = DateTime.Today,
                Lines = lines, Payments = payments, DraftOnly = draftOnly
            });
            Snackbar.Add(T.T(draftOnly ? "common.saved" : "pos.collected") +
                         (result.VoucherNo is null ? "" : $" — {result.VoucherNo}"),
                Severity.Success);
            if (closeAfter) MudDialog.Close(DialogResult.Ok(result));
            else await ReloadRowsAsync(actor);
        }
        catch (AppException ex) { Snackbar.Add(T.T(ex.Code), Severity.Error); }
        finally { _busy = false; }
    }
}
