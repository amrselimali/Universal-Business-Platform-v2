@inject BookingCollectionService Collections
@inject UserContext UserContext
@inject UiCulture T
@inject ISnackbar Snackbar
@inject PermissionService Permissions

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@T.T("pos.collect_title") — @CustomerName</MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (_rows.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                @T.T("pos.no_outstanding_services")
            </MudAlert>
        }
        else
        {
            <MudTable Items="_rows" Dense="true" Hover="true" Elevation="0" Class="ubp-table">
                <HeaderContent>
                    <MudTh>@T.T("sales.booking_no")</MudTh>
                    <MudTh>@T.T("pos.services")</MudTh>
                    <MudTh Align="Right">@T.T("accounting.total")</MudTh>
                    <MudTh Align="Right">@T.T("pos.paid_previously")</MudTh>
                    <MudTh Align="Right">@T.T("pos.remaining")</MudTh>
                    <MudTh></MudTh>
                    <MudTh Align="Right">@T.T("pos.collect_amount")</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.BookingNo</MudTd>
                    <MudTd>@context.Services</MudTd>
                    <MudTd Align="Right"><b>@context.TotalAmount.ToString("N2")</b></MudTd>
                    <MudTd Align="Right">@context.PaidAmount.ToString("N2")</MudTd>
                    <MudTd Align="Right"><b>@context.RemainingAmount.ToString("N2")</b></MudTd>
                    <MudTd>
                        <MudCheckBox T="bool" Value="@context.Selected" Dense="true"
                                     ValueChanged="@(v => Toggle(context, v))" />
                    </MudTd>
                    <MudTd Align="Right">
                        <MudNumericField T="decimal" @bind-Value="context.Amount"
                                         Min="0m" Max="@context.RemainingAmount" Format="N2"
                                         Dense="true" Disabled="@(!context.Selected)" />
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <MudPaper Elevation="0" Class="pa-2 mt-2">
                <div class="pos-receipt-totals">
                    <div><span>@T.T("pos.paid_previously")</span><span>@SelectedPaidBefore.ToString("N2")</span></div>
                    <div><span>@T.T("pos.total_fees")</span><span>@FeeTotal.ToString("N2")</span></div>
                    <div><b>@T.T("pos.grand_due")</b><b>@((SelectedTotal + FeeTotal).ToString("N2"))</b></div>
                    <div><span>@T.T("pos.collected_amount")</span><span>@CollectedTotal.ToString("N2")</span></div>
                    <div><span>@T.T("pos.remaining")</span><span>@RemainingAfter.ToString("N2")</span></div>
                </div>
            </MudPaper>

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">@T.T("treasury.treasuries")</MudText>
            <MudTable Items="_payments" Dense="true" Elevation="0" Class="ubp-table">
                <HeaderContent>
                    <MudTh>@T.T("treasury.treasury")</MudTh>
                    <MudTh Align="Right">@T.T("pos.payment_total")</MudTh>
                    <MudTh Align="Right">@T.T("pos.collected_amount")</MudTh>
                    <MudTh Align="Right">@T.T("pos.fee")</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudSelect T="Guid" Value="context.TreasuryId" Dense="true"
                                   ValueChanged="@(v => PickTreasury(context, v))">
                            @foreach (var treasury in Treasuries)
                            {
                                <MudSelectItem T="Guid" Value="@treasury.Id">
                                    @treasury.Code — @treasury.NameAr
                                    (@treasury.ProviderFeePercent.ToString("N2")%)
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd Align="Right">
                        <MudNumericField T="decimal" Value="context.Total" Min="0m"
                                         ValueChanged="@(v => SetTotal(context, v))"
                                         Format="N2" Dense="true" />
                    </MudTd>
                    <MudTd Align="Right">@context.Collected.ToString("N2")</MudTd>
                    <MudTd Align="Right">@context.Fee.ToString("N2")</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       OnClick="@(() => _payments.Remove(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="mt-2"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="AddPayment">@T.T("pos.add_payment")</MudButton>

            <div class="pos-receipt mt-3">
                <div class="pos-receipt-head">
                    <div><b>@T.T("pos.receipt")</b> — @T.T("pos.preview")</div>
                    <div>@DateTime.Now.ToString("yyyy-MM-dd HH:mm")</div>
                    <div>@CustomerName</div>
                </div>
                <table>
                    <tbody>
                        @foreach (var row in _rows.Where(r => r.Selected && r.Amount > 0))
                        {
                            <tr>
                                <td>@row.BookingNo — @row.Services</td>
                                <td class="num">@row.Amount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="pos-receipt-totals">
                    <div><span>@T.T("pos.collected_amount")</span><span>@CollectedTotal.ToString("N2")</span></div>
                    <div><span>@T.T("pos.fees")</span><span>@FeeTotal.ToString("N2")</span></div>
                    <div><b>@T.T("accounting.total")</b><b>@GrandTotal.ToString("N2")</b></div>
                    <div><span>@T.T("pos.paid")</span><span>@PaidTotal.ToString("N2")</span></div>
                    <div><span>@T.T("pos.remaining_on_services")</span><span>@RemainingOnServices.ToString("N2")</span></div>
                </div>
                <div class="mt-2">
                    <MudText Typo="Typo.caption" Class="ubp-muted">@T.T("pos.partial_allowed")</MudText>
                </div>
            </div>
        }
        <MudText Typo="Typo.caption" Class="ubp-muted d-block mt-2">
            @T.T("pos.collect_buttons_hint")
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@T.T("common.cancel")</MudButton>
        @if (_canDraft)
        {
            <MudButton Color="Color.Warning" Variant="Variant.Outlined" OnClick="DraftAsync"
                       Disabled="CannotSave">@T.T("pos.save_draft_only")</MudButton>
        }
        @if (_canWhatsApp)
        {
            <MudButton Color="Color.Success" Variant="Variant.Outlined" OnClick="WhatsAppAsync"
                       StartIcon="@Icons.Material.Filled.Send"
                       Disabled="CannotSave">@T.T("pos.save_and_send_whatsapp")</MudButton>
        }
        @if (_canComplete)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CompleteAsync"
                       Disabled="CannotSave">@T.T("pos.complete")</MudButton>
        }
    </DialogActions>
</MudDialog>

