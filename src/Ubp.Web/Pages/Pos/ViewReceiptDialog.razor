@inject PosService Pos
@inject UserContext UserContext
@inject UiCulture T
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@T.T("pos.receipt") — @(_receipt?.DocNo ?? "…")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (_receipt is null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">@T.T("pos.receipt_not_found")</MudAlert>
        }
        else
        {
            <div id="receipt-view-area" class="pos-receipt ubp-print-receipt">
                <div class="pos-receipt-head">
                    <div><b>@T.T("pos.receipt_no"): @_receipt.DocNo</b></div>
                    <div>@_receipt.PartyName</div>
                </div>
                <table>
                    <thead>
                        <tr>
                            @if (_receipt.IsCollectionReceipt)
                            {
                                <th>@T.T("pos.booking_service_price")</th>
                                <th class="num">@T.T("pos.booking_value_col")</th>
                            }
                            else
                            {
                                <th>@T.T("pos.service")</th>
                                <th class="num">@T.T("common.quantity")</th>
                                <th class="num">@T.T("pos.value")</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in _receipt.DisplayLines)
                        {
                            <tr>
                                <td>@line.Description</td>
                                @if (_receipt.IsCollectionReceipt)
                                {
                                    <td class="num">@line.Value.ToString("N2")</td>
                                }
                                else
                                {
                                    <td class="num">@line.Quantity.ToString("N2")</td>
                                    <td class="num">@line.Value.ToString("N2")</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="pos-receipt-totals">
                    <div><span>@T.T("pos.due_value")</span><span>@_receipt.DueTotal.ToString("N2")</span></div>
                    <div><span>@T.T("pos.tax")</span><span>@_receipt.TaxTotal.ToString("N2")</span></div>
                    <div><span>@T.T("pos.collection_fee")</span><span>@_receipt.FeeTotal.ToString("N2")</span></div>
                    <div><b>@T.T("pos.grand_due")</b><b>@_receipt.GrandDue.ToString("N2")</b></div>
                    <div><span>@T.T("pos.paid_amount")</span><span>@_receipt.PaidAmount.ToString("N2")</span></div>
                    <div><span>@T.T("pos.remaining")</span><span>@_receipt.RemainingDue.ToString("N2")</span></div>
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@T.T("common.close")</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Print" Variant="Variant.Outlined"
                   OnClick="PrintAsync" Disabled="@(_receipt is null)">@T.T("common.print")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid VoucherId { get; set; }

    private Voucher? _receipt;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var actor = await UserContext.RequireAsync();
            _receipt = await Pos.GetReceiptAsync(actor, VoucherId);
        }
        catch (AppException ex) { Snackbar?.Add(T.T(ex.Code), Severity.Error); }
        finally { _loading = false; }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task PrintAsync() => await JS.InvokeVoidAsync("ubpPrint");
}
