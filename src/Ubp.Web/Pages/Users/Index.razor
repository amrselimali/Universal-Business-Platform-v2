@page "/users"
@attribute [Authorize]
@inherits SecurePageBase
<PageTitle>@T.T("screen.users")</PageTitle>

@if (Denied)
{
    <ForbiddenView />
}
else if (Loading)
{
    <div class="ubp-loading"><MudProgressCircular Indeterminate="true" /></div>
}
else
{
    <PageHeader Title="@T.T("screen.users")" Subtitle="@T.T("users.hint")">
        <Actions>
            @if (Can(ActionCodes.Add))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddAsync">@T.T("common.add")</MudButton>
            }
        </Actions>
    </PageHeader>

    <MudPaper Elevation="0" Class="ubp-card">
        <div class="ubp-toolbar">
            <MudTextField @bind-Value="_search" Placeholder="@T.T("common.search")" Immediate="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="ubp-search"
                          DebounceInterval="300" OnDebounceIntervalElapsed="ReloadAsync" />
            <MudSwitch T="bool" Value="_includeInactive" Label="@T.T("common.include_inactive")"
                       Color="Color.Primary" ValueChanged="OnFilterChanged" />
        </div>

        <MudTable @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true"
                  Elevation="0" RowsPerPage="25" Class="ubp-table">
            <HeaderContent>
                <MudTh><MudTableSortLabel T="UserListItem" SortLabel="username" InitialDirection="SortDirection.Ascending">@T.T("auth.username")</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="UserListItem" SortLabel="name">@T.T("users.name")</MudTableSortLabel></MudTh>
                <MudTh>@T.T("users.branches")</MudTh>
                <MudTh>@T.T("users.warehouses")</MudTh>
                <MudTh>@T.T("common.status")</MudTh>
                <MudTh Align="Right">@T.T("common.actions")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@T.T("auth.username")">
                    <div class="ubp-user-cell">
                        <span class="ubp-user-avatar">@Initial(context)</span>
                        <div>
                            <div class="ubp-code">@context.Username</div>
                            @if (context.IsSuperAdmin)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">@T.T("role.super_admin")</MudChip>
                            }
                            else if (context.IsAdmin)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@T.T("role.admin")</MudChip>
                            }
                        </div>
                    </div>
                </MudTd>
                <MudTd DataLabel="@T.T("users.name")">@context.Name</MudTd>
                <MudTd DataLabel="@T.T("users.branches")">@context.BranchCount</MudTd>
                <MudTd DataLabel="@T.T("users.warehouses")">@context.WarehouseCount</MudTd>
                <MudTd DataLabel="@T.T("common.status")">
                    <div class="ubp-inline">
                        @if (context.IsLocked)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">@T.T("users.locked")</MudChip>
                        }
                        <MudSwitch T="bool" Value="@context.IsActive" Color="Color.Success"
                                   Disabled="@(!Can(ActionCodes.Edit))"
                                   ValueChanged="@(v => ToggleAsync(context, v))" />
                    </div>
                </MudTd>
                <MudTd Align="Right">
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true" AnchorOrigin="Origin.BottomRight">
                        @if (Can(ActionCodes.Edit))
                        {
                            <MudMenuItem OnClick="@(() => EditAsync(context))" Icon="@Icons.Material.Filled.Edit">
                                @T.T("common.edit")
                            </MudMenuItem>
                        }
                        @if (Can(ActionCodes.ResetPassword))
                        {
                            <MudMenuItem OnClick="@(() => ResetPasswordAsync(context))" Icon="@Icons.Material.Filled.Key">
                                @T.T("users.reset_password")
                            </MudMenuItem>
                        }
                        @if (Can(ActionCodes.Unlock) && context.IsLocked)
                        {
                            <MudMenuItem OnClick="@(() => UnlockAsync(context))" Icon="@Icons.Material.Filled.LockOpen">
                                @T.T("users.unlock")
                            </MudMenuItem>
                        }
                        @if (Can(ActionCodes.Delete))
                        {
                            <MudMenuItem OnClick="@(() => DeleteAsync(context))" Icon="@Icons.Material.Filled.Delete">
                                @T.T("common.delete")
                            </MudMenuItem>
                        }
                    </MudMenu>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 25 }" RowsPerPageString="@T.T("common.rows_per_page")" />
            </PagerContent>
        </MudTable>
    </MudPaper>
}
