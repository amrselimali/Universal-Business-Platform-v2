@inherits ComponentBase

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEdit ? T.T("currencies.edit") : T.T("currencies.add"))</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <div class="ubp-form-grid">
                <MudTextField @bind-Value="_input.CurrencyCode" Label="@T.T("common.code")" Required="true"
                              Variant="Variant.Outlined" MaxLength="3" />
                <MudTextField @bind-Value="_input.NameAr" Label="@T.T("common.name_ar")" Required="true"
                              Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_input.NameEn" Label="@T.T("common.name_en")"
                              Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_input.Symbol" Label="@T.T("currencies.symbol")"
                              Variant="Variant.Outlined" />
                <MudNumericField @bind-Value="_decimals" Label="@T.T("currencies.decimals")"
                                 Variant="Variant.Outlined" Min="0" Max="6" />
                <MudSwitch @bind-Value="_input.IsBase" Label="@T.T("currencies.base")" Color="Color.Success"
                           Disabled="@(IsEdit && Model!.IsBase)" />
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">@T.T("common.cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync"
                   Disabled="_busy">@T.T("common.save")</MudButton>
    </DialogActions>
</MudDialog>
