@inherits ComponentBase

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(Model is null ? T.T("common.add") : T.T("common.edit"))</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <div class="ubp-form-grid">
                @if (Model is null)
                {
                    <MudTextField Value="@(_nextCode ?? "")" Label="@T.T("common.code")"
                                  ReadOnly="true" Variant="Variant.Outlined" MaxLength="30"
                                  HelperText="@T.T("common.auto_generated")" />
                }
                else
                {
                    <MudTextField Value="@_input.Code" Label="@T.T("common.code")"
                                  ReadOnly="true" Variant="Variant.Outlined" MaxLength="30"
                                  HelperText="@T.T("common.auto_generated")" />
                }
                <MudTextField @bind-Value="_input.NameAr" Label="@T.T("common.name_ar")" Required="true"
                              Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_input.NameEn" Label="@T.T("common.name_en")"
                              Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_input.Phone" Label="@T.T("common.phone")" Required="true"
                              Variant="Variant.Outlined" MaxLength="30" />
                <MudTextField @bind-Value="_input.Email" Label="@T.T("settings.email")"
                              Variant="Variant.Outlined" MaxLength="200" />
                <MudTextField @bind-Value="_input.JobTitle" Label="@T.T("settings.job_title")"
                              Required="true" Variant="Variant.Outlined" MaxLength="100" />
                <MudSelect T="Guid?" @bind-Value="_input.RoleId" Label="@T.T("settings.admin_role")"
                           Variant="Variant.Outlined" Clearable="true">
                    @foreach (var role in _roles)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)role.Id)">
                            @RoleName(role)
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="Guid?" Value="_input.BranchId" Label="الفرع (أو الشركة)"
                           Variant="Variant.Outlined" Clearable="true"
                           ValueChanged="OnBranchChanged"
                           HelperText="اتركه فارغًا = موظف على مستوى الشركة">
                    @foreach (var branch in _branches)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)branch.Id)">@branch.NameAr</MudSelectItem>
                    }
                </MudSelect>
                <MudDatePicker @bind-Date="_hireDate" Label="@T.T("settings.hire_date")"
                               Variant="Variant.Outlined" DateFormat="yyyy-MM-dd" Editable="true" />
                <MudSelect T="Guid?" @bind-Value="_input.TreatmentAccountId"
                           Label="حساب تحميل الجلسة العلاجية" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var account in _accounts)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)account.Id)">
                            @account.Code — @account.NameAr
                        </MudSelectItem>
                    }
                </MudSelect>
                <div style="grid-column: 1 / -1;">
                    <MudSwitch @bind-Value="_input.IsBookingReceiver" Color="Color.Primary"
                               Label="@T.T("settings.role_receiver")" />
                    <MudSwitch @bind-Value="_input.IsSeller" Color="Color.Primary"
                               Label="@T.T("settings.role_seller")" />
                    <MudSwitch @bind-Value="_input.IsServiceExecutor" Color="Color.Primary"
                               Label="@T.T("settings.role_executor")" />
                    <MudSwitch @bind-Value="_input.IsActive" Color="Color.Success"
                               Label="@T.T("common.active")" />
                </div>
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">@T.T("common.cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync"
                   Disabled="_busy">@T.T("common.save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Employee? Model { get; set; }

    [Inject] private MasterDataService MasterData { get; set; } = default!;
    [Inject] private LookupService Lookup { get; set; } = default!;
    [Inject] private BranchService Branches { get; set; } = default!;
    [Inject] private UserContext UserContext { get; set; } = default!;
    [Inject] private UiCulture T { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudForm _form = default!;
    private EmployeeInput _input = new();
    private IReadOnlyList<Role> _roles = Array.Empty<Role>();
    private IReadOnlyList<Account> _accounts = Array.Empty<Account>();
    private IReadOnlyList<Branch> _branches = Array.Empty<Branch>();
    private DateTime? _hireDate;
    private bool _busy;
    private string? _nextCode;

    protected override async Task OnInitializedAsync()
    {
        var actor = await UserContext.GetAsync();
        if (actor is not null)
        {
            _roles = await MasterData.EmployeeRoleOptionsAsync(actor);
            _accounts = await Lookup.PostableAccountsAsync(actor);
            _branches = await Branches.OptionsAsync(actor);
            // الافتراضي = فرع المستخدم الحالي (ولا يظهر غير فروع المستخدم).
            if (Model is null && actor.CurrentBranchId is { } currentBranch)
                _input.BranchId = currentBranch;
            if (Model is null)
                _nextCode = await MasterData.NextEmployeeCodeAsync(actor, _input.BranchId);
        }

        if (Model is null) return;
        _input = new EmployeeInput
        {
            Code = Model.Code, NameAr = Model.NameAr, NameEn = Model.NameEn, Phone = Model.Phone,
            Email = Model.Email, UserId = Model.UserId, RoleId = Model.RoleId,
            JobTitle = Model.JobTitle, HireDate = Model.HireDate,
            IsBookingReceiver = Model.IsBookingReceiver, IsSeller = Model.IsSeller,
            IsServiceExecutor = Model.IsServiceExecutor, Notes = Model.Notes,
            IsActive = Model.IsActive, TreatmentAccountId = Model.TreatmentAccountId,
            BranchId = Model.BranchId
        };
        _hireDate = Model.HireDate;
    }

    /// <summary>يُحدِّث معاينة الكود الآلي عند تغيير فرع الموظف (للإضافة فقط).</summary>
    private async Task OnBranchChanged(Guid? branchId)
    {
        _input.BranchId = branchId;
        if (Model is not null) return;
        var actor = await UserContext.GetAsync();
        if (actor is null) return;
        _nextCode = await MasterData.NextEmployeeCodeAsync(actor, branchId);
    }

    private string RoleName(Role role) =>
        T.Language == "en" && !string.IsNullOrWhiteSpace(role.NameEn) ? role.NameEn! : role.NameAr;

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        _busy = true;
        try
        {
            var actor = await UserContext.RequireAsync();
            _input.HireDate = _hireDate;
            var saved = await MasterData.SaveEmployeeAsync(actor, Model?.Id,
                Model?.Version ?? 0, _input);
            MudDialog.Close(DialogResult.Ok(saved));
        }
        catch (AppException ex) { Snackbar.Add(T.T(ex.Code), Severity.Error); }
        finally { _busy = false; }
    }
}
