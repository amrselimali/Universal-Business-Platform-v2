@inherits ComponentBase

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(Model is null ? T.T("common.add") : T.T("common.edit"))</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <div class="ubp-form-grid">
                <MudTextField @bind-Value="_input.Code" Label="@T.T("common.code")" Required="true"
                              Variant="Variant.Outlined" MaxLength="20" />
                <MudTextField @bind-Value="_input.NameAr" Label="@T.T("common.name_ar")" Required="true"
                              Variant="Variant.Outlined" />
                <MudNumericField @bind-Value="_rate" Label="@T.T("settings.tax_rate")" Min="0m" Max="100m"
                                 Variant="Variant.Outlined" Format="N2" />
                <MudSelect T="Guid?" @bind-Value="_input.OutputAccountId" Label="@T.T("settings.tax_output_account")"
                           Variant="Variant.Outlined" Clearable="true">
                    @foreach (var account in _accounts)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)account.Id)">
                            @account.Code — @account.DisplayName(_english)
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="Guid?" @bind-Value="_input.InputAccountId" Label="@T.T("settings.tax_input_account")"
                           Variant="Variant.Outlined" Clearable="true">
                    @foreach (var account in _accounts)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)account.Id)">
                            @account.Code — @account.DisplayName(_english)
                        </MudSelectItem>
                    }
                </MudSelect>
                <div style="grid-column: 1 / -1;">
                    <MudSwitch @bind-Value="_input.IsInclusiveAllowed" Color="Color.Primary"
                               Label="@T.T("settings.tax_inclusive_allowed")" />
                    <MudSwitch @bind-Value="_input.IsActive" Color="Color.Success" Label="@T.T("common.active")" />
                </div>
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">@T.T("common.cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync"
                   Disabled="_busy">@T.T("common.save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Tax? Model { get; set; }

    [Inject] private MasterDataService MasterData { get; set; } = default!;
    [Inject] private AccountService Accounts { get; set; } = default!;
    [Inject] private UserContext UserContext { get; set; } = default!;
    [Inject] private UiCulture T { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudForm _form = default!;
    private TaxInput _input = new();
    private IReadOnlyList<Account> _accounts = Array.Empty<Account>();
    private decimal _rate;
    private bool _busy;
    private bool _english;

    protected override async Task OnInitializedAsync()
    {
        _english = T.Language == "en";
        var actor = await UserContext.GetAsync();
        if (actor is not null) _accounts = await Accounts.PostableAsync(actor);

        if (Model is null) return;
        _input = new TaxInput
        {
            Code = Model.Code, NameAr = Model.NameAr, NameEn = Model.NameEn, Rate = Model.Rate,
            IsInclusiveAllowed = Model.IsInclusiveAllowed, OutputAccountId = Model.OutputAccountId,
            InputAccountId = Model.InputAccountId, Notes = Model.Notes, IsActive = Model.IsActive
        };
        _rate = Model.Rate;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        _busy = true;
        try
        {
            var actor = await UserContext.RequireAsync();
            _input.Rate = _rate;
            var saved = await MasterData.SaveTaxAsync(actor, Model?.Id, Model?.Version ?? 0, _input);
            MudDialog.Close(DialogResult.Ok(saved));
        }
        catch (AppException ex) { Snackbar.Add(T.T(ex.Code), Severity.Error); }
        finally { _busy = false; }
    }
}
