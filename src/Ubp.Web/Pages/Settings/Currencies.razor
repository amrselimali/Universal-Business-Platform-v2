@page "/settings/currencies"
@attribute [Authorize]
@inherits SecurePageBase
<PageTitle>@T.T("screen.currencies")</PageTitle>

@if (Denied)
{
    <ForbiddenView />
}
else if (Loading)
{
    <div class="ubp-loading"><MudProgressCircular Indeterminate="true" /></div>
}
else
{
    <PageHeader Title="@T.T("screen.currencies")" Subtitle="@T.T("currencies.hint")">
        <Actions>
            @if (Can(ActionCodes.Add))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddAsync">@T.T("common.add")</MudButton>
            }
        </Actions>
    </PageHeader>

    <MudPaper Elevation="0" Class="ubp-card">
        <div class="ubp-toolbar">
            <MudTextField @bind-Value="_search" Placeholder="@T.T("common.search")" Immediate="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="ubp-search"
                          DebounceInterval="300" OnDebounceIntervalElapsed="ReloadAsync" />
        </div>

        <MudTable @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true"
                  Elevation="0" RowsPerPage="25" Class="ubp-table">
            <HeaderContent>
                <MudTh><MudTableSortLabel T="Currency" SortLabel="code" InitialDirection="SortDirection.Ascending">@T.T("common.code")</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="Currency" SortLabel="name_ar">@T.T("common.name_ar")</MudTableSortLabel></MudTh>
                <MudTh>@T.T("currencies.symbol")</MudTh>
                <MudTh>@T.T("currencies.decimals")</MudTh>
                <MudTh>@T.T("currencies.base")</MudTh>
                <MudTh Align="Right">@T.T("common.actions")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@T.T("common.code")"><span class="ubp-code">@context.CurrencyCode</span></MudTd>
                <MudTd DataLabel="@T.T("common.name_ar")">@context.NameAr</MudTd>
                <MudTd DataLabel="@T.T("currencies.symbol")">@context.Symbol</MudTd>
                <MudTd DataLabel="@T.T("currencies.decimals")">@context.Decimals</MudTd>
                <MudTd DataLabel="@T.T("currencies.base")">
                    @if (context.IsBase)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">@T.T("currencies.base")</MudChip>
                    }
                </MudTd>
                <MudTd Align="Right">
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true" AnchorOrigin="Origin.BottomRight">
                        @if (Can(ActionCodes.Edit))
                        {
                            <MudMenuItem OnClick="@(() => EditAsync(context))" Icon="@Icons.Material.Filled.Edit">
                                @T.T("common.edit")
                            </MudMenuItem>
                        }
                        @if (Can(ActionCodes.Delete) && !context.IsBase)
                        {
                            <MudMenuItem OnClick="@(() => DeleteAsync(context))" Icon="@Icons.Material.Filled.Delete">
                                @T.T("common.delete")
                            </MudMenuItem>
                        }
                    </MudMenu>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 25 }" RowsPerPageString="@T.T("common.rows_per_page")" />
            </PagerContent>
        </MudTable>
    </MudPaper>
}
