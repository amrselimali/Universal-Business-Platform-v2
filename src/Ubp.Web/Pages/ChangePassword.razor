@page "/change-password"
@attribute [Authorize]
@inject UserContext UserContext
@inject AuthService Auth
@inject UiCulture T
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
<PageTitle>@T.T("auth.change_password")</PageTitle>

<PageHeader Title="@T.T("auth.change_password")" Subtitle="@T.T("auth.change_password_hint")" />

<MudPaper Elevation="0" Class="ubp-card ubp-form-card">
    @if (_done)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">@T.T("auth.password_changed")</MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Href="/login">@T.T("auth.relogin")</MudButton>
    }
    else
    {
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_current" Label="@T.T("auth.current_password")" InputType="InputType.Password"
                          Variant="Variant.Outlined" Required="true" />
            <MudTextField @bind-Value="_next" Label="@T.T("auth.new_password")" InputType="InputType.Password"
                          Variant="Variant.Outlined" Required="true" Class="mt-3" />
            <MudTextField @bind-Value="_confirm" Label="@T.T("auth.confirm_password")" InputType="InputType.Password"
                          Variant="Variant.Outlined" Required="true" Class="mt-3" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="SaveAsync"
                       Disabled="_busy">@T.T("common.save")</MudButton>
        </MudForm>
    }
</MudPaper>

@code {
    private MudForm _form = default!;
    private string _current = "";
    private string _next = "";
    private string _confirm = "";
    private bool _busy;
    private bool _done;

    private async Task SaveAsync()
    {
        if (_next != _confirm)
        {
            Snackbar.Add(T.T("validation.password_mismatch"), Severity.Error);
            return;
        }
        _busy = true;
        try
        {
            var actor = await UserContext.RequireAsync();
            await Auth.ChangePasswordAsync(actor, _current, _next);
            _done = true;
        }
        catch (AppException ex)
        {
            Snackbar.Add(T.T(ex.Code), Severity.Error);
        }
        finally { _busy = false; }
    }
}
