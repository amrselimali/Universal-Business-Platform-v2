@inherits ComponentBase

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(Model is null
                ? (ParentId is null ? T.T("accounting.add_root") : T.T("accounting.add_child"))
                : T.T("common.edit"))
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            @if (ParentName is not null)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    @T.T("accounting.parent"): @ParentName
                </MudAlert>
            }
            <div class="ubp-form-grid">
                <MudTextField @bind-Value="_input.Code" Label="@T.T("common.code")" Required="true"
                              Variant="Variant.Outlined" MaxLength="20" />
                <MudTextField @bind-Value="_input.NameAr" Label="@T.T("common.name_ar")" Required="true"
                              Variant="Variant.Outlined" MaxLength="200" />
                <MudTextField @bind-Value="_input.NameEn" Label="@T.T("common.name_en")"
                              Variant="Variant.Outlined" MaxLength="200" />
                <MudSelect T="Guid?" @bind-Value="_input.BranchId" Label="@T.T("common.branch")"
                           Variant="Variant.Outlined" Clearable="true">
                    @foreach (var branch in _branches)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)branch.Id)">@branch.NameAr</MudSelectItem>
                    }
                </MudSelect>
                <MudSwitch @bind-Value="_input.IsGroup" Label="@T.T("accounting.is_group")"
                           Color="Color.Primary" />
                <MudSwitch @bind-Value="_input.IsActive" Label="@T.T("common.active")"
                           Color="Color.Success" />
                <MudTextField @bind-Value="_input.Notes" Label="@T.T("common.notes")"
                              Variant="Variant.Outlined" Lines="2" />
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">@T.T("common.cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync"
                   Disabled="_busy">@T.T("common.save")</MudButton>
    </DialogActions>
</MudDialog>
