@page "/accounting/journals"
@attribute [Authorize]
@inherits SecurePageBase
<PageTitle>@T.T("screen.journals")</PageTitle>

@if (Denied)
{
    <ForbiddenView />
}
else if (Loading)
{
    <div class="ubp-loading"><MudProgressCircular Indeterminate="true" /></div>
}
else
{
    <PageHeader Title="@T.T("screen.journals")" Subtitle="@T.T("accounting.journals_hint")">
        <Actions>
            @if (Can(ActionCodes.Create))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">
                    @T.T("common.add")
                </MudButton>
            }
        </Actions>
    </PageHeader>

    <MudPaper Elevation="0" Class="ubp-card">
        <div class="ubp-toolbar">
            <MudTextField @bind-Value="_search" Placeholder="@T.T("common.search")" Immediate="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="ubp-search"
                          DebounceInterval="300" OnDebounceIntervalElapsed="ReloadAsync" />
            <MudSwitch T="bool" Value="_includeInactive" Label="@T.T("common.include_inactive")"
                       Color="Color.Primary" ValueChanged="OnFilterChanged" />
        </div>

        <MudTable @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true"
                  Elevation="0" RowsPerPage="25" Class="ubp-table">
            <HeaderContent>
                <MudTh><MudTableSortLabel T="Journal" SortLabel="sort_order">@T.T("common.code")</MudTableSortLabel></MudTh>
                <MudTh>@T.T("common.name_ar")</MudTh>
                <MudTh>@T.T("accounting.journal_type")</MudTh>
                <MudTh>@T.T("accounting.allow_manual")</MudTh>
                <MudTh>@T.T("accounting.entries_count")</MudTh>
                <MudTh>@T.T("common.status")</MudTh>
                <MudTh Align="Right">@T.T("common.actions")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@T.T("common.code")"><span class="ubp-code">@context.Code</span></MudTd>
                <MudTd DataLabel="@T.T("common.name_ar")">@context.DisplayName(IsEnglish)</MudTd>
                <MudTd DataLabel="@T.T("accounting.journal_type")">@T.T("accounting.jtype_" + context.JournalType)</MudTd>
                <MudTd DataLabel="@T.T("accounting.allow_manual")">
                    <MudIcon Icon="@(context.AllowManual ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                             Color="@(context.AllowManual ? Color.Success : Color.Default)" Size="Size.Small" />
                </MudTd>
                <MudTd DataLabel="@T.T("accounting.entries_count")">@context.EntriesCount</MudTd>
                <MudTd DataLabel="@T.T("common.status")">
                    <MudSwitch T="bool" Value="@context.IsActive" Color="Color.Success"
                               Disabled="@(!Can(ActionCodes.ToggleActive))"
                               ValueChanged="@(v => ToggleAsync(context, v))" />
                </MudTd>
                <MudTd Align="Right">
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true"
                             AnchorOrigin="Origin.BottomRight">
                        @if (Can(ActionCodes.Edit))
                        {
                            <MudMenuItem OnClick="@(() => EditAsync(context))"
                                         Icon="@Icons.Material.Filled.Edit">@T.T("common.edit")</MudMenuItem>
                        }
                        @if (Can(ActionCodes.Edit) && !context.IsSystem)
                        {
                            <MudMenuItem OnClick="@(() => DeleteAsync(context))"
                                         Icon="@Icons.Material.Filled.Delete">@T.T("common.delete")</MudMenuItem>
                        }
                    </MudMenu>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 25 }" RowsPerString="@T.T("common.rows_per_page")" />
            </PagerContent>
        </MudTable>
    </MudPaper>
}
