@page "/"
@page "/dashboard"
@attribute [Authorize]
@inherits SecurePageBase
@inject SettingsService Settings
@inject PermissionService Permissions
@inject BranchService Branches
@inject UserFavoriteService Favorites
<PageTitle>@T.T("screen.dashboard")</PageTitle>

@if (Denied)
{
    <ForbiddenView />
}
else if (Loading)
{
    <div class="ubp-loading"><MudProgressCircular Indeterminate="true" /></div>
}
else
{
    <div class="ubp-hero">
        <div>
            <div class="ubp-eyebrow">@T.T("dashboard.welcome")</div>
            <h1>@_companyName</h1>
            <p>@Actor!.DisplayName — @_branchName</p>
        </div>
        <div class="ubp-hero-mark">U</div>
    </div>

    <PageHeader Title="المفضلة" Subtitle="شاشات مختارة للوصول السريع" />
    @if (_favoriteScreens.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            اختر شاشة من «كل الشاشات» بالضغط على النجمة ★ لإضافتها إلى المفضلة.
        </MudAlert>
    }
    else
    {
        <div class="ubp-shortcuts mb-3">
            @foreach (var screen in _favoriteScreens)
            {
                @ScreenTile(screen)
            }
        </div>
    }

    <PageHeader Title="كل الشاشات" Subtitle="كل شاشات وزراير المستخدم — اضغط ★ للإضافة للمفضلة" />
    @foreach (var group in _groups)
    {
        if (group.Screens.Count == 0) { continue; }
        <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">@T.T(group.TitleKey)</MudText>
        <div class="ubp-shortcuts">
            @foreach (var screen in group.Screens)
            {
                @ScreenTile(screen)
            }
        </div>
    }
}

@code {
    protected override string ScreenCode => ScreenCodes.Dashboard;

    private string _companyName = "";
    private string _branchName = "";
    private HashSet<string> _favoriteCodes = new(StringComparer.OrdinalIgnoreCase);
    private List<ScreenDefinition> _favoriteScreens = new();
    private sealed record Group(string TitleKey, List<ScreenDefinition> Screens);
    private List<Group> _groups = new();

    private static readonly string[] GroupOrder =
    {
        "group.main", "group.sales", "group.inventory", "group.partners", "group.accounting",
        "group.definitions", "group.security", "group.reports", "group.system"
    };

    protected override async Task OnLoadAsync()
    {
        var settings = await Settings.GetAsync();
        _companyName = settings.CompanyName;
        var branchOptions = await Branches.OptionsAsync(Actor!);
        _branchName = Actor!.CurrentBranchId is { } branchId
            ? branchOptions.FirstOrDefault(b => b.Id == branchId)?.NameAr ?? T.T("branch.none")
            : T.T("branch.none");

        var visible = (await Permissions.GetVisibleScreenCodesAsync(Actor!)).ToHashSet();
        _favoriteCodes = (await Favorites.ListAsync(Actor!)).ToHashSet(StringComparer.OrdinalIgnoreCase);

        var screens = AppRegistry.Screens
            .Where(s => s.Code != ScreenCodes.Dashboard && visible.Contains(s.Code)
                        && !s.Route.Contains('{'))
            .ToList();

        _groups = GroupOrder.Select(key => new Group(key,
            NavOrder.Apply(screens.Where(s => s.GroupKey == key).ToList()).ToList())).ToList();

        _favoriteScreens = screens.Where(s => _favoriteCodes.Contains(s.Code)).ToList();
    }

    private RenderFragment ScreenTile(ScreenDefinition screen) => @<div class="ubp-shortcut"
            style="justify-content:space-between;cursor:default">
            <a href="@screen.Route"
               style="display:flex;align-items:center;gap:8px;flex:1;text-decoration:none;color:inherit">
                <MudIcon Icon="@AppIcons.Resolve(screen.Icon)" />
                <span>@T.T(screen.TitleKey)</span>
            </a>
            <MudIconButton Icon="@(_favoriteCodes.Contains(screen.Code)
                                      ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)"
                           Size="Size.Small"
                           Color="@(_favoriteCodes.Contains(screen.Code) ? Color.Warning : Color.Default)"
                           OnClick="@(() => ToggleFavoriteAsync(screen.Code))" />
        </div>;

    private async Task ToggleFavoriteAsync(string screenCode) => await RunAsync(async () =>
    {
        var favorite = await Favorites.ToggleAsync(Actor!, screenCode);
        if (favorite) _favoriteCodes.Add(screenCode);
        else _favoriteCodes.Remove(screenCode);
        _favoriteScreens = _groups.SelectMany(g => g.Screens)
            .Where(s => _favoriteCodes.Contains(s.Code)).ToList();
        StateHasChanged();
    });
}
