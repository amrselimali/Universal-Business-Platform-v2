@namespace Ubp.Web.Components
@inject UiCulture Culture
@inject SettingsService Settings
@code {
    private string _primary = "#0F766E";
    private string _primaryDark = "#115E59";
    // كسر الكاش: يتغير تلقائيًا مع بدء التطبيق/النشر لتحميل أحدث ملفات CSS/JS.
    private static readonly string _assetVersion = DateTime.UtcNow.Ticks.ToString("x");

    protected override async Task OnInitializedAsync()
    {
        var s = await Settings.GetAsync();
        if (!string.IsNullOrWhiteSpace(s.ThemeColor) &&
            System.Text.RegularExpressions.Regex.IsMatch(s.ThemeColor, "^#[0-9A-Fa-f]{6}$"))
        {
            _primary = s.ThemeColor;
            _primaryDark = Darken(s.ThemeColor);
        }
    }

    private static string Darken(string hex)
    {
        var r = Convert.ToInt32(hex.Substring(1, 2), 16);
        var g = Convert.ToInt32(hex.Substring(3, 2), 16);
        var b = Convert.ToInt32(hex.Substring(5, 2), 16);
        int F(int c) => Math.Max(0, (int)Math.Round(c * 0.78));
        return $"#{F(r):X2}{F(g):X2}{F(b):X2}";
    }
}
<!DOCTYPE html>
<html lang="@Culture.Language" dir="@Culture.Dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Universal Business Platform</title>
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="app.css?v=@_assetVersion" rel="stylesheet" />
    <link href="css/responsive.css?v=@_assetVersion" rel="stylesheet" />
    <style>
        /* يُوضع بعد ملفات CSS ليتغلب على اللون الافتراضي في :root (قابل للتخصيص من الإعدادات). */
        html:root { --ubp-primary: @_primary !important; --ubp-primary-dark: @_primaryDark !important; }
    </style>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="js/pos.js"></script>
    <script src="js/reports.js"></script>
    <script src="js/shift.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>
</html>
