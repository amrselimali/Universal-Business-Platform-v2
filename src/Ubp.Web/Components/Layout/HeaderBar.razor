@inject UiCulture T
@inject NavigationManager Navigation
@implements IDisposable

<MudAppBar Elevation="0" Class="ubp-appbar" Dense="false">
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                   Class="ubp-menu-btn" OnClick="DrawerToggle" />

    <div class="ubp-appbar-brand">
        @if (!string.IsNullOrWhiteSpace(LogoUrl))
        {
            <img src="@LogoUrl" alt="logo" class="ubp-logo" />
        }
        else
        {
            <div class="ubp-brand-mark small">U</div>
        }
        <span class="ubp-company">@CompanyName</span>
    </div>

    <MudSpacer />

    <div class="ubp-header-actions">
        @if (Branches.Count > 1)
        {
            <form method="post" action="/auth/branches" class="ubp-inline-form" id="ubp-branches-form">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@CurrentPath" />
                <div class="ubp-branch-checks">
                    @foreach (var branch in Branches)
                    {
                        <input type="hidden" name="branchIds" value="@branch.Id"
                               disabled="@(!SelectedBranches.Contains(branch.Id))" />
                    }
                </div>
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent>
                        <button type="button" class="ubp-user-btn" title="@T.T("branch.current")">
                            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" />
                            <span class="ubp-user-name">@BranchesLabel</span>
                            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" />
                        </button>
                    </ActivatorContent>
                    <ChildContent>
                        <MudText Typo="Typo.caption" Class="px-3 py-1">@T.T("branch.current")</MudText>
                        @foreach (var branch in Branches)
                        {
                            var id = branch.Id;
                            <MudCheckBox T="bool" Dense="true" Class="px-3"
                                         Value="@SelectedBranches.Contains(id)"
                                         ValueChanged="@(v => ToggleBranch(id, v))"
                                         Label="@branch.NameAr" />
                        }
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   Class="ma-2" OnClick="ApplyBranchesAsync">تطبيق</MudButton>
                    </ChildContent>
                </MudMenu>
            </form>
        }
        else if (Branches.Count == 1)
        {
            <span class="ubp-branch-label">@Branches[0].NameAr</span>
        }

        <form method="post" action="/auth/language" class="ubp-inline-form ubp-lang-form">
            <AntiforgeryToken />
            <input type="hidden" name="language" value="@(T.Language == "ar" ? "en" : "ar")" />
            <input type="hidden" name="returnUrl" value="@CurrentPath" />
            <button type="submit" class="ubp-lang-btn">@(T.Language == "ar" ? "EN" : "ع")</button>
        </form>

        <MudBadge Content="@_unread" Color="Color.Error" Overlap="true" Visible="@(_unread > 0)">
            <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit"
                           Href="/notifications/center" title="@T.T("screen.notifications")" />
        </MudBadge>

        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <ActivatorContent>
                <button type="button" class="ubp-user-btn">
                    <span class="ubp-user-avatar">@Initial</span>
                    <span class="ubp-user-name">@Actor.DisplayName</span>
                    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" />
                </button>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Href="/change-password" Icon="@Icons.Material.Filled.Key">
                    @T.T("auth.change_password")
                </MudMenuItem>
                <MudMenuItem Href="/" Icon="@Icons.Material.Filled.Home">
                    @T.T("common.home")
                </MudMenuItem>
            </ChildContent>
        </MudMenu>

        <form method="post" action="/auth/logout" class="ubp-inline-form">
            <AntiforgeryToken />
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit"
                           ButtonType="ButtonType.Submit" title="@T.T("auth.logout")" />
        </form>
    </div>
</MudAppBar>

@code {
    [Parameter] public ActorContext Actor { get; set; } = default!;
    [Parameter] public string CompanyName { get; set; } = "";
    [Parameter] public string? LogoUrl { get; set; }
    [Parameter] public IReadOnlyList<Branch> Branches { get; set; } = Array.Empty<Branch>();
    [Parameter] public EventCallback DrawerToggle { get; set; }

    private Guid? CurrentBranchId => Actor.CurrentBranchId;
    private string CurrentPath => "/" + Navigation.ToBaseRelativePath(Navigation.Uri).TrimStart('/');

    private HashSet<Guid> _selectedBranches = new();

    private HashSet<Guid> SelectedBranches
    {
        get
        {
            if (_selectedBranches.Count == 0 && Actor.FilterBranchIds is { Length: > 0 } f)
                _selectedBranches = f.ToHashSet();
            else if (_selectedBranches.Count == 0)
                _selectedBranches = Branches.Select(b => b.Id).ToHashSet();
            return _selectedBranches;
        }
    }

    private string BranchesLabel => Branches.Count == 1
        ? Branches[0].NameAr
        : $"الفروع ({SelectedBranches.Count}/{Branches.Count})";

    private void ToggleBranch(Guid id, bool selected)
    {
        if (selected) _selectedBranches = SelectedBranches.Append(id).ToHashSet();
        else if (SelectedBranches.Count > 1)
            _selectedBranches = SelectedBranches.Where(x => x != id).ToHashSet();
        StateHasChanged();
    }

    private Task ApplyBranchesAsync()
    {
        // يُرسل النموذج (branchIds المخفية للمُحدَّد فقط) لضبط فروع الجلسة على الخادم.
        if (_js is not null) return _js.InvokeVoidAsync("eval",
            "document.getElementById('ubp-branches-form').submit()").AsTask();
        return Task.CompletedTask;
    }
    private string Initial => (Actor.DisplayName.Length > 0 ? Actor.DisplayName[..1] : "U").ToUpperInvariant();
}

@code {
    [Inject] private NotificationService Notifications { get; set; } = default!;
    [Inject] private NotificationBroadcaster Broadcaster { get; set; } = default!;
    [Inject] private UserContext UserContext { get; set; } = default!;
    [Inject] private IJSRuntime _jsRuntime { get; set; } = default!;

    private Microsoft.JSInterop.IJSRuntime? _js => _jsRuntime;

    private int _unread;
    private IDisposable? _subscription;

    protected override async Task OnInitializedAsync()
    {
        var actor = await UserContext.GetAsync();
        if (actor is null) return;

        _unread = await Notifications.UnreadCountAsync(actor);
        _subscription = Broadcaster.Subscribe(actor.UserId, _ =>
        {
            _unread++;
            return InvokeAsync(StateHasChanged);
        });
    }

    public void Dispose()
    {
        _subscription?.Dispose();
        _subscription = null;
    }
}
