@namespace Ubp.Web.Components
<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
            <Authorizing>
                <div class="ubp-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(EmptyLayout)">
            <NotFoundView />
        </LayoutView>
    </NotFound>
</Router>
